{
  "name": "dmw-astro-base",
  "version": "1.0.0-beta.63",
  "description": "AstroWind: A free template using Astro 6 and Tailwind CSS v4. Astro starter theme.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "setup": "node scripts/setup.mjs",
    "new": "node scripts/new.mjs",
    "brand": "node scripts/brand.mjs",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:golive": "node scripts/check-golive.mjs",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/open-sans": "^5.3.0",
    "astro": "^7.0.6",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "quill": "^2.0.3",
    "ultrahtml": "^1.6.0",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/partytown": "^2.1.7",
    "@eslint/js": "^10.0.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "astro-compress": "^2.4.1",
    "astro-eslint-parser": "^1.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "yaml": ">=2.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "workerd@1.20260811.1": true
  }
}
