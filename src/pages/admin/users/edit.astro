---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import AdminShell from '~/components/AdminShell.astro';
import { Icon } from 'astro-icon/components';
import { isAdmin, adminRedirect } from '~/lib/admin';
import { getDb, hashPassword } from '~/lib/auth';

// User management is strictly admin-only (contributors don't see this page).
if (!(await isAdmin(Astro))) return Astro.redirect(adminRedirect(Astro));

const db = await getDb();
const id = Number(Astro.url.searchParams.get('id') ?? 0);
if (!db || !id) return Astro.redirect('/admin/users');

interface UserRow {
  id: number;
  username: string;
  email: string;
  first_name: string;
  last_name: string;
  role: string;
  created_at: string;
}

const existing = await db
  .prepare('SELECT id, username, email, first_name, last_name, role, created_at FROM users WHERE id = ?')
  .bind(id)
  .first<UserRow>();
if (!existing) return Astro.redirect('/admin/users');

const isSelf = existing.id === Astro.locals.user?.id;

/** Bylines are stored on posts as plain display names, not user ids. */
const displayName = (first: string, last: string) => `${first} ${last}`.trim();
const oldName = displayName(existing.first_name, existing.last_name);

// How many articles carry this contributor's current byline — drives the
// "also update bylines" option, since renaming the account alone would leave
// their published articles credited to the old name.
const bylineCount = oldName
  ? ((await db.prepare('SELECT COUNT(*) AS n FROM posts WHERE author = ?').bind(oldName).first<{ n: number }>())?.n ??
    0)
  : 0;

let form = {
  username: existing.username,
  email: existing.email,
  first_name: existing.first_name,
  last_name: existing.last_name,
  role: existing.role,
};
let error = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const username = String(fd.get('username') ?? '').trim();
  const email = String(fd.get('email') ?? '').trim();
  const firstName = String(fd.get('first_name') ?? '').trim();
  const lastName = String(fd.get('last_name') ?? '').trim();
  // An admin can't demote themselves — that could leave the site with no admin.
  const role = isSelf ? existing.role : String(fd.get('role') ?? 'editor');
  const password = String(fd.get('password') ?? '');
  const rewriteBylines = fd.get('rewrite_bylines') === 'on';

  form = { username, email, first_name: firstName, last_name: lastName, role };

  if (!username || !email || !firstName) {
    error = 'Username, email, and first name are required.';
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    error = 'Please enter a valid email address.';
  } else if (!['admin', 'editor'].includes(role)) {
    error = 'Choose a valid role.';
  } else if (password && password.length < 8) {
    error = 'The new password must be at least 8 characters.';
  } else if (
    await db
      .prepare('SELECT id FROM users WHERE (username = ? OR email = ?) AND id != ?')
      .bind(username, email, id)
      .first()
  ) {
    error = 'Another contributor already uses that username or email.';
  } else {
    await db
      .prepare('UPDATE users SET username = ?, email = ?, first_name = ?, last_name = ?, role = ? WHERE id = ?')
      .bind(username, email, firstName, lastName, role, id)
      .run();

    // Optional and off by default: renaming the account does not silently
    // rewrite what's printed on published articles.
    const newName = displayName(firstName, lastName);
    if (rewriteBylines && oldName && newName && newName !== oldName) {
      await db.prepare('UPDATE posts SET author = ? WHERE author = ?').bind(newName, oldName).run();
    }

    if (password) {
      await db
        .prepare('UPDATE users SET password_hash = ? WHERE id = ?')
        .bind(await hashPassword(password), id)
        .run();
      // Their old sessions are meaningless with a new password. Signing
      // yourself out mid-edit would be a nasty surprise, so keep your own.
      if (!isSelf) await db.prepare('DELETE FROM sessions WHERE user_id = ?').bind(id).run();
    }

    return Astro.redirect('/admin/users?updated=1');
  }
}

const inputClass =
  'py-2.5 px-4 block w-full rounded-xl border border-gray-300 bg-white text-default placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none';
const labelClass = 'block text-sm font-semibold text-default mb-1.5';

const metadata = { title: 'Edit contributor — Admin', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <AdminShell title="Edit contributor" current="users">
    <a
      href="/admin/users"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline mb-5"
    >
      <Icon name="tabler:arrow-left" class="h-4 w-4" /> Back to all contributors
    </a>

    {
      error && (
        <p class="mb-6 rounded-xl bg-red-50 text-red-700 px-4 py-3 text-sm" role="alert">
          {error}
        </p>
      )
    }

    <form method="post" class="grid gap-6 lg:grid-cols-3 items-start">
      <div class="lg:col-span-2 rounded-2xl bg-white shadow-md border border-gray-100 p-6 space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="first_name" class={labelClass}>First name</label>
            <input id="first_name" name="first_name" type="text" value={form.first_name} required class={inputClass} />
          </div>
          <div>
            <label for="last_name" class={labelClass}>
              Last name <span class="font-normal text-muted">(optional)</span>
            </label>
            <input id="last_name" name="last_name" type="text" value={form.last_name} class={inputClass} />
          </div>
        </div>

        <div>
          <label for="username" class={labelClass}>Username</label>
          <input id="username" name="username" type="text" value={form.username} required class={inputClass} />
          <p class="mt-1.5 text-xs text-muted">What they type to sign in. Changing it does not sign them out.</p>
        </div>

        <div>
          <label for="email" class={labelClass}>Email</label>
          <input id="email" name="email" type="email" value={form.email} required class={inputClass} />
        </div>

        {
          bylineCount > 0 && (
            <div class="rounded-xl bg-primary/5 border border-primary/20 p-4">
              <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" name="rewrite_bylines" class="h-4 w-4 mt-0.5 accent-[var(--aw-color-primary)]" />
                <span class="text-sm text-default">
                  Also update the byline on{' '}
                  <strong>
                    {bylineCount} article{bylineCount === 1 ? '' : 's'}
                  </strong>{' '}
                  currently credited to “{oldName}”.
                  <span class="block text-xs text-muted mt-1">
                    Only needed if you change the name above. Bylines are stored on each article, so they keep the old
                    name unless you tick this.
                  </span>
                </span>
              </label>
            </div>
          )
        }
      </div>

      <div class="rounded-2xl bg-white shadow-md border border-gray-100 p-6 space-y-5 lg:sticky lg:top-24">
        <div>
          <label for="role" class={labelClass}>Role</label>
          {
            isSelf ? (
              <>
                <p class="py-2.5 px-4 rounded-xl bg-gray-100 text-default text-sm capitalize">{existing.role}</p>
                <p class="mt-1.5 text-xs text-muted">You cannot change your own role.</p>
              </>
            ) : (
              <>
                <select id="role" name="role" class={inputClass}>
                  <option value="editor" selected={form.role === 'editor'}>
                    Editor — writes and publishes articles
                  </option>
                  <option value="admin" selected={form.role === 'admin'}>
                    Admin — full access, including this page
                  </option>
                </select>
              </>
            )
          }
        </div>

        <div>
          <label for="password" class={labelClass}>
            New password <span class="font-normal text-muted">(optional)</span>
          </label>
          <input
            id="password"
            name="password"
            type="password"
            minlength="8"
            autocomplete="new-password"
            placeholder="Leave blank to keep current"
            class={inputClass}
          />
          <p class="mt-1.5 text-xs text-muted">
            At least 8 characters. {isSelf ? 'You stay signed in.' : 'Signs them out of any device they are using.'}
          </p>
        </div>

        <div class="text-xs text-muted">
          Account created {
            new Date(existing.created_at.replace(' ', 'T')).toLocaleDateString('en-IE', {
              day: '2-digit',
              month: 'short',
              year: 'numeric',
            })
          }
        </div>

        <button type="submit" class="btn-primary w-full">
          <Icon name="tabler:device-floppy" class="h-5 w-5 mr-1.5" /> Save contributor
        </button>
      </div>
    </form>
  </AdminShell>
</Layout>
