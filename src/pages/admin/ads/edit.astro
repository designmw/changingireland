---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import AdminShell from '~/components/AdminShell.astro';
import { Icon } from 'astro-icon/components';
import { isAdmin, adminRedirect } from '~/lib/admin';
import { getDb, getUploads } from '~/lib/auth';
import { createAd, updateAd, getAdById } from '~/lib/ads';

if (!(await isAdmin(Astro))) return Astro.redirect(adminRedirect(Astro));

const db = await getDb();
const id = Number(Astro.url.searchParams.get('id') ?? 0);

let form = { label: '', link_url: '', image_key: '', active: 1, sort_order: '0' };
let error = '';

if (id && db) {
  const existing = await getAdById(db, id);
  if (!existing) return Astro.redirect('/admin/ads');
  form = {
    label: existing.label,
    link_url: existing.link_url,
    image_key: existing.image_key,
    active: existing.active,
    sort_order: String(existing.sort_order),
  };
}

if (Astro.request.method === 'POST' && db) {
  const fd = await Astro.request.formData();
  const label = String(fd.get('label') ?? '').trim();
  const linkUrl = String(fd.get('link_url') ?? '').trim();
  const active = fd.get('active') === 'on';
  const sortOrder = Number(fd.get('sort_order') ?? 0) || 0;
  const imageFile = fd.get('image');

  form = { label, link_url: linkUrl, image_key: form.image_key, active: active ? 1 : 0, sort_order: String(sortOrder) };

  const isFile = (f: unknown): f is File => f instanceof File && f.size > 0;

  if (!label) {
    error = 'Please name the ad (e.g. the advertiser) — it is also the image description for screen readers.';
  } else if (linkUrl && !/^(https?:\/\/|\/)/.test(linkUrl)) {
    error = 'The link must start with https:// (or / for a page on this site).';
  } else if (!id && !isFile(imageFile)) {
    error = 'Please choose the ad image.';
  } else if (isFile(imageFile) && !/\.(png|jpe?g|webp|gif)$/i.test(imageFile.name)) {
    error = 'The ad image must be a PNG, JPG, WebP, or GIF.';
  } else {
    const uploads = await getUploads();
    let imageKey = form.image_key;
    if (uploads && isFile(imageFile)) {
      const ext = imageFile.name.match(/\.(png|jpe?g|webp|gif)$/i)?.[0].toLowerCase() ?? '.png';
      imageKey = `ads/${Date.now()}${ext}`;
      const type =
        ext === '.png' ? 'image/png' : ext === '.webp' ? 'image/webp' : ext === '.gif' ? 'image/gif' : 'image/jpeg';
      await uploads.put(imageKey, imageFile.stream(), { httpMetadata: { contentType: type } });
    }

    const payload = { label, imageKey, linkUrl, active, sortOrder };
    if (id) await updateAd(db, id, payload);
    else await createAd(db, payload);
    return Astro.redirect('/admin/ads?saved=1');
  }
}

const inputClass =
  'py-2.5 px-4 block w-full rounded-xl border border-gray-300 bg-white text-default placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none';
const labelClass = 'block text-sm font-semibold text-default mb-1.5';

const metadata = { title: id ? 'Edit ad — Admin' : 'New ad — Admin', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <AdminShell title={id ? 'Edit ad' : 'New ad'} current="ads">
    <a
      href="/admin/ads"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline mb-5"
    >
      <Icon name="tabler:arrow-left" class="h-4 w-4" /> Back to all ads
    </a>

    {
      error && (
        <p class="mb-6 rounded-xl bg-red-50 text-red-700 px-4 py-3 text-sm" role="alert">
          {error}
        </p>
      )
    }

    <form method="post" enctype="multipart/form-data" class="grid gap-6 lg:grid-cols-3 items-start">
      <div class="lg:col-span-2 rounded-2xl bg-white shadow-md border border-gray-100 p-6 space-y-5">
        <div>
          <label for="label" class={labelClass}>Name / advertiser</label>
          <input
            id="label"
            name="label"
            type="text"
            value={form.label}
            required
            placeholder="Community Finance Ireland"
            class={inputClass}
          />
          <p class="mt-1.5 text-xs text-muted">Read out by screen readers as the image description.</p>
        </div>

        <div>
          <label for="link_url" class={labelClass}>
            Link <span class="font-normal text-muted">(optional — where clicking the ad goes)</span>
          </label>
          <input
            id="link_url"
            name="link_url"
            type="url"
            value={form.link_url}
            placeholder="https://example.ie"
            class={inputClass}
          />
        </div>

        <div>
          <label for="image" class={labelClass}>
            Ad image {id && <span class="font-normal text-muted">(leave empty to keep the current image)</span>}
          </label>
          <input
            id="image"
            name="image"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif"
            class="block w-full text-sm text-default file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:bg-primary file:text-white file:font-semibold file:cursor-pointer hover:file:opacity-90"
          />
          <p class="mt-1.5 text-xs text-muted">Wide banner shapes work best on the homepage (e.g. 1200 × 200 px).</p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <span class={labelClass}>Status</span>
            <label
              class="flex items-center gap-3 rounded-xl border border-gray-300 px-4 py-3 cursor-pointer hover:border-primary transition-colors"
            >
              <input
                type="checkbox"
                name="active"
                checked={form.active === 1}
                class="h-4 w-4 accent-[var(--aw-color-primary)]"
              />
              <span class="text-sm font-medium text-default">Active</span>
            </label>
          </div>
          <div>
            <label for="sort_order" class={labelClass}>Order</label>
            <input id="sort_order" name="sort_order" type="number" value={form.sort_order} class={inputClass} />
            <p class="mt-1.5 text-xs text-muted">Lowest number shows first.</p>
          </div>
        </div>
      </div>

      <div class="rounded-2xl bg-white shadow-md border border-gray-100 p-6 space-y-5 lg:sticky lg:top-24">
        {
          form.image_key && (
            <div>
              <span class={labelClass}>Current image</span>
              <img
                src={`/files/${form.image_key}`}
                alt=""
                width="240"
                height="80"
                class="w-full rounded-lg border border-gray-200 shadow-sm object-contain"
              />
            </div>
          )
        }
        <button type="submit" class="btn-primary w-full">
          <Icon name="tabler:device-floppy" class="h-5 w-5 mr-1.5" /> Save ad
        </button>
      </div>
    </form>
  </AdminShell>
</Layout>

<script>
  // Convert the chosen ad image to WebP in the browser before the form posts;
  // the server endpoint still accepts PNG/JPEG if conversion falls back.
  import { compressFormImages } from '~/lib/webp-client';
  const form = document.querySelector<HTMLFormElement>('form[enctype="multipart/form-data"]');
  if (form) compressFormImages(form, ['image']);
</script>
