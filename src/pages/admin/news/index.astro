---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import AdminShell from '~/components/AdminShell.astro';
import AdminToast from '~/components/AdminToast.astro';
import AdminConfirmDelete from '~/components/AdminConfirmDelete.astro';
import { Icon } from 'astro-icon/components';
import { isEditor, adminRedirect } from '~/lib/admin';
import { getDb } from '~/lib/auth';
import { deletePost, getAllPosts, getTaxonomyCounts, isLive, parseTaxonomies, type PostRow } from '~/lib/posts';

if (!(await isEditor(Astro))) return Astro.redirect(adminRedirect(Astro));

const db = await getDb();
let notice = '';

if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  if (form.get('action') === 'delete') {
    const id = Number(form.get('id') ?? 0);
    if (id) {
      await deletePost(db, id);
      return Astro.redirect('/admin/news?deleted=1');
    }
  }
}

if (Astro.url.searchParams.has('deleted')) notice = 'Post deleted.';
if (Astro.url.searchParams.has('saved')) notice = 'Post saved.';

// The archive is ~1k posts, so the admin list is paginated, searchable, and
// filterable server-side rather than rendering one huge table.
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const status = (Astro.url.searchParams.get('status') ?? '').trim(); // '', published, draft, scheduled, featured
const category = (Astro.url.searchParams.get('category') ?? '').trim().toLowerCase();
const sort = (Astro.url.searchParams.get('sort') ?? 'newest').trim(); // newest, oldest, title
const pageNum = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1));
const PER_PAGE = 25;

let rows: PostRow[] = [];
let total = 0;
let totalPages = 1;
const categories = db ? await getTaxonomyCounts(db, 'categories') : [];

if (db) {
  // Filters cover drafts too, so work on the full list rather than getPublishedPage.
  let all = await getAllPosts(db);
  if (q) {
    const needle = q.toLowerCase();
    all = all.filter((p) => `${p.title} ${p.slug} ${p.author}`.toLowerCase().includes(needle));
  }
  if (status === 'published') all = all.filter((p) => p.published === 1);
  else if (status === 'draft') all = all.filter((p) => p.published === 0);
  else if (status === 'scheduled') all = all.filter((p) => p.published === 1 && !isLive(p));
  else if (status === 'featured') all = all.filter((p) => p.featured === 1);
  if (category) all = all.filter((p) => parseTaxonomies(p.categories).some((c) => c.slug === category));
  if (sort === 'oldest') all = all.slice().reverse();
  else if (sort === 'title') all = all.slice().sort((a, b) => a.title.localeCompare(b.title, 'en-IE'));
  else if (!status) {
    // Default view: latest published articles first — drafts sort below them
    // (use the Drafts filter to work on those).
    all = all.slice().sort((a, b) => b.published - a.published);
  }

  total = all.length;
  totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
  rows = all.slice((pageNum - 1) * PER_PAGE, pageNum * PER_PAGE);
}

const filterParams: Record<string, string> = {
  ...(q ? { q } : {}),
  ...(status ? { status } : {}),
  ...(category ? { category } : {}),
  ...(sort !== 'newest' ? { sort } : {}),
};
const pageUrl = (p: number) => `/admin/news?${new URLSearchParams({ ...filterParams, page: String(p) })}`;

const selectClass =
  'py-2 px-3 rounded-xl border border-gray-300 bg-white text-sm text-default focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none';

const fmt = (d: string | null) =>
  d
    ? new Date(d.replace(' ', 'T')).toLocaleDateString('en-IE', { day: '2-digit', month: 'short', year: 'numeric' })
    : '—';

const metadata = { title: 'Articles — Admin', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <AdminShell title="Articles" current="news">
    {notice && <AdminToast message={notice} />}

    <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
      <p class="text-muted text-sm">
        {total} article{total === 1 ? '' : 's'}{q ? ` matching “${q}”` : ''}
      </p>
      <a href="/admin/news/edit" class="btn-primary">
        <Icon name="tabler:plus" class="h-5 w-5 mr-1.5" /> New article
      </a>
    </div>

    <form method="get" action="/admin/news" class="mb-6 flex flex-wrap items-end gap-3">
      <div class="flex-1 min-w-48">
        <label for="admin-search" class="block text-xs font-semibold text-default mb-1">Search</label>
        <input
          id="admin-search"
          name="q"
          type="search"
          value={q}
          placeholder="Title, address, or author…"
          class="py-2 px-3.5 w-full rounded-xl border border-gray-300 bg-white text-sm text-default placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none"
        />
      </div>
      <div>
        <label for="admin-status" class="block text-xs font-semibold text-default mb-1">Status</label>
        <select id="admin-status" name="status" class={selectClass}>
          <option value="">All</option>
          <option value="published" selected={status === 'published'}>Published</option>
          <option value="draft" selected={status === 'draft'}>Drafts</option>
          <option value="scheduled" selected={status === 'scheduled'}>Scheduled</option>
          <option value="featured" selected={status === 'featured'}>Featured</option>
        </select>
      </div>
      <div>
        <label for="admin-category" class="block text-xs font-semibold text-default mb-1">Category</label>
        <select id="admin-category" name="category" class={selectClass}>
          <option value="">All categories</option>
          {
            categories.map((c) => (
              <option value={c.slug} selected={c.slug === category}>
                {c.title}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="admin-sort" class="block text-xs font-semibold text-default mb-1">Sort by</label>
        <select id="admin-sort" name="sort" class={selectClass}>
          <option value="newest" selected={sort === 'newest'}>Newest first</option>
          <option value="oldest" selected={sort === 'oldest'}>Oldest first</option>
          <option value="title" selected={sort === 'title'}>Title A–Z</option>
        </select>
      </div>
      <button type="submit" class="btn-secondary text-sm py-2 px-4">Apply</button>
      {
        (q || status || category || sort !== 'newest') && (
          <a href="/admin/news" class="text-sm font-semibold text-primary hover:underline py-2">
            Clear
          </a>
        )
      }
    </form>

    {
      rows.length === 0 ? (
        <div class="rounded-2xl bg-white shadow-md border border-gray-100 p-10 text-center">
          <Icon name="tabler:news-off" class="h-10 w-10 mx-auto text-muted mb-3" />
          <p class="text-muted">{q ? 'No articles match your search.' : 'No articles yet. Create your first one.'}</p>
        </div>
      ) : (
        <div class="rounded-2xl bg-white shadow-md border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-primary/5 text-xs uppercase tracking-wide text-muted">
                <tr>
                  <th scope="col" class="px-5 py-3 font-semibold">
                    Title
                  </th>
                  <th scope="col" class="px-5 py-3 font-semibold">
                    Author
                  </th>
                  <th scope="col" class="px-5 py-3 font-semibold">
                    Status
                  </th>
                  <th scope="col" class="px-5 py-3 font-semibold whitespace-nowrap">
                    Date
                  </th>
                  <th scope="col" class="px-5 py-3 font-semibold text-right">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {rows.map((p) => (
                  <tr class="hover:bg-primary/[0.03]">
                    <td class="px-5 py-4">
                      <a href={`/admin/news/edit?id=${p.id}`} class="font-semibold text-default hover:text-primary">
                        {p.title}
                      </a>
                      <span class="block text-xs text-muted mt-0.5">/{p.slug}</span>
                    </td>
                    <td class="px-5 py-4 text-sm text-muted whitespace-nowrap">{p.author || '—'}</td>
                    <td class="px-5 py-4">
                      {p.published && !isLive(p) ? (
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 text-blue-800 px-2.5 py-1 text-xs font-semibold">
                          <Icon name="tabler:clock" class="h-3.5 w-3.5" /> Scheduled
                        </span>
                      ) : p.published ? (
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-100 text-green-800 px-2.5 py-1 text-xs font-semibold">
                          <Icon name="tabler:circle-check" class="h-3.5 w-3.5" /> Published
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 text-amber-800 px-2.5 py-1 text-xs font-semibold">
                          <Icon name="tabler:pencil" class="h-3.5 w-3.5" /> Draft
                        </span>
                      )}
                    </td>
                    <td class="px-5 py-4 text-sm text-muted whitespace-nowrap">
                      {fmt(p.published_at ?? p.created_at)}
                    </td>
                    <td class="px-5 py-4">
                      <div class="flex items-center justify-end gap-3">
                        {p.published ? (
                          <a
                            href={`/${p.slug}`}
                            target="_blank"
                            rel="noopener"
                            class="text-sm font-semibold text-primary hover:underline"
                          >
                            View<span class="sr-only"> {p.title}</span>
                          </a>
                        ) : null}
                        <a
                          href={`/admin/news/edit?id=${p.id}`}
                          class="text-sm font-semibold text-primary hover:underline"
                        >
                          Edit<span class="sr-only"> {p.title}</span>
                        </a>
                        <form method="post" data-confirm={p.title}>
                          <input type="hidden" name="action" value="delete" />
                          <input type="hidden" name="id" value={p.id} />
                          <button
                            type="submit"
                            class="text-sm font-semibold text-red-700 hover:underline cursor-pointer"
                          >
                            Delete<span class="sr-only"> {p.title}</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    {
      totalPages > 1 && (
        <nav aria-label="Article list pages" class="mt-6 flex items-center justify-between">
          {pageNum > 1 ? (
            <a href={pageUrl(pageNum - 1)} class="btn-secondary text-sm py-2 px-4">
              Previous
            </a>
          ) : (
            <span />
          )}
          <p class="text-sm text-muted">
            Page {pageNum} of {totalPages}
          </p>
          {pageNum < totalPages ? (
            <a href={pageUrl(pageNum + 1)} class="btn-secondary text-sm py-2 px-4">
              Next
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </AdminShell>

  <AdminConfirmDelete />
</Layout>
