---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import AdminShell from '~/components/AdminShell.astro';
import AdminToast from '~/components/AdminToast.astro';
import { Icon } from 'astro-icon/components';
import { isAdmin, adminRedirect } from '~/lib/admin';
import { getDb } from '~/lib/auth';
import { getTaxonomyCounts } from '~/lib/posts';
import { getSetting, setSetting, HOMEPAGE_CATEGORIES_KEY } from '~/lib/settings';

if (!(await isAdmin(Astro))) return Astro.redirect(adminRedirect(Astro));

const db = await getDb();
let notice = '';

if (Astro.request.method === 'POST' && db) {
  const fd = await Astro.request.formData();
  // Keep the tick order the editor chose (formData preserves DOM order).
  const chosen = fd.getAll('categories').map(String).slice(0, 12);
  await setSetting(db, HOMEPAGE_CATEGORIES_KEY, chosen);
  return Astro.redirect('/admin/settings?saved=1');
}

if (Astro.url.searchParams.has('saved')) notice = 'Homepage settings saved.';

const allCategories = db ? await getTaxonomyCounts(db, 'categories') : [];
const chosen: string[] = db ? await getSetting(db, HOMEPAGE_CATEGORIES_KEY, []) : [];
// Default (nothing saved yet): the six biggest categories.
const effective = chosen.length > 0 ? chosen : allCategories.slice(0, 6).map((c) => c.slug);

const metadata = { title: 'Homepage — Admin', robots: { index: false, follow: false } };
---

<Layout metadata={metadata}>
  <AdminShell title="Homepage" current="settings">
    {notice && <AdminToast message={notice} />}

    <form method="post" class="rounded-2xl bg-white shadow-md border border-gray-100 p-6 max-w-3xl">
      <fieldset>
        <legend class="font-heading font-bold text-lg text-heading mb-1">Category blocks</legend>
        <p class="text-sm text-muted mb-5">
          Tick the categories that appear as blocks on the homepage (each block shows the category's newest story).
          Nothing ticked means the six biggest categories are used.
        </p>
        <div class="grid gap-2 sm:grid-cols-2">
          {
            allCategories.map((c) => (
              <label class="flex items-center gap-3 rounded-xl border border-gray-300 px-4 py-2.5 cursor-pointer hover:border-primary transition-colors">
                <input
                  type="checkbox"
                  name="categories"
                  value={c.slug}
                  checked={effective.includes(c.slug)}
                  class="h-4 w-4 accent-[var(--aw-color-primary)]"
                />
                <span class="text-sm font-medium text-default">
                  {c.title} <span class="text-muted font-normal">({c.count})</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <button type="submit" class="btn-primary mt-6">
        <Icon name="tabler:device-floppy" class="h-5 w-5 mr-1.5" /> Save homepage settings
      </button>
    </form>
  </AdminShell>
</Layout>
