---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import Grid from '~/components/blog/Grid.astro';
import PageNav from '~/components/blog/PageNav.astro';
import SearchForm from '~/components/blog/SearchForm.astro';

import { blogListRobots } from '~/utils/blog';
import { getDb } from '~/lib/auth';
import { getPublishedPage, getTaxonomyCounts } from '~/lib/posts';
import { rowToPost } from '~/lib/post-adapter';

// The full archive, newest first, straight from D1 so /admin publishing is
// live immediately. ~1k posts, so pagination is server-side.
const db = await getDb();
const pageNum = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1));

const result = db ? await getPublishedPage(db, { page: pageNum }) : { rows: [], total: 0, page: 1, totalPages: 1 };
const posts = result.rows.map(rowToPost);
const categories = db ? (await getTaxonomyCounts(db, 'categories')).slice(0, 12) : [];

const metadata = {
  title: `News${result.page > 1 ? ` — Page ${result.page}` : ''}`,
  description: 'All the latest community development, social inclusion and local news stories from Changing Ireland.',
  robots: {
    index: blogListRobots?.index && result.page === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: { type: 'blog' },
};
---

<Layout metadata={metadata}>
  <PageHeader title="News" subtitle="Community development, social inclusion and local news from around Ireland." />

  <section class="px-4 sm:px-6 lg:px-8 py-12 lg:py-16 mx-auto max-w-7xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <p class="text-sm text-muted">
        {result.total} article{result.total === 1 ? '' : 's'} · page {result.page} of {result.totalPages}
      </p>
      <SearchForm />
    </div>

    {
      categories.length > 0 && (
        <nav aria-label="Browse by category" class="mb-10 flex flex-wrap gap-2">
          {categories.map((c) => (
            <a
              href={`/category/${c.slug}`}
              class="rounded-full px-4 py-1.5 text-sm font-semibold bg-white text-gray-700 border border-gray-300 hover:border-primary hover:text-primary transition-colors"
            >
              {c.title}
            </a>
          ))}
        </nav>
      )
    }

    <Grid posts={posts} />
    <PageNav page={result.page} totalPages={result.totalPages} base="/news" />
  </section>
</Layout>
