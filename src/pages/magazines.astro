---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { getDb } from '~/lib/auth';
import { getAllMagazines } from '~/lib/magazines';

// The full PDF back-catalogue (2001 onwards). One card per issue: cover,
// title, contents blurb, PDF link — searchable and sortable client-side
// (without JavaScript the full newest-first list still renders).
const db = await getDb();
const magazines = db ? await getAllMagazines(db) : [];

const seasonOf = (title: string) => title.split(':')[0]?.trim() ?? title;
const subtitleOf = (title: string) => (title.includes(':') ? title.split(':').slice(1).join(':').trim() : '');

// A magazine description is the issue’s contents: a run of entries, each a
// subject and what it covers. They are rendered as a list with the subject in
// bold, matching how issue 93 was formatted by hand in the admin.
//
// The imported text is inconsistent about how it separates those entries.
// Most issues use one line each; issue 92 puts several on a line divided by
// "•" and runs four more together with dashes. Splitting on newlines alone —
// which is what this did — left those as an unreadable wall of text.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// Rich-text editors (and pasted-in text) litter the HTML with non-breaking
// spaces, which stop long lines wrapping and push them off the page.
const unglue = (s: string) => s.replace(/&nbsp;|\u00a0/g, ' ');

/** Break a contents blurb into its individual entries. */
function descriptionItems(text: string): string[] {
  return unglue(text)
    .split(/\n|•/)
    .flatMap((line) => {
      const trimmed = line.trim();
      // A line carrying no label but several dash-separated sentences is
      // really several entries. Lines that DO have a label keep their dash,
      // because it belongs to the label there ("LEAD STORY – CRAIG O’BRIEN:").
      if (!/:/.test(trimmed) && (trimmed.match(/\s[–—]\s/g) ?? []).length >= 2) {
        return trimmed.split(/\s[–—]\s/);
      }
      return [trimmed];
    })
    .map((line) => line.trim().replace(/^[–—-]\s*/, ''))
    .filter(Boolean);
}

/**
 * Bold the subject that opens an entry — "MOYROSS:" in "MOYROSS: The Berlin
 * Wall came down faster." Three shapes appear in the archive: a colon label, a
 * dash label, and entries that simply SHOUT the subject before continuing in
 * sentence case ("SOUTHSIDE PARTNERSHIP has a new plan").
 *
 * The label is length-capped so an ordinary sentence that happens to contain a
 * colon isn’t bolded half way through.
 */
function boldSubject(item: string): string {
  const colon = item.match(/^([^:]{2,60}):\s*/);
  if (colon) {
    const rest = item.slice(colon[0].length).replace(/^[–—-]\s*/, '');
    return `<strong>${escapeHtml(colon[1].trim())}:</strong> ${escapeHtml(rest)}`.trim();
  }
  const dash = item.match(/^([^–—-]{2,60})\s[–—-]\s*/);
  if (dash) {
    return `<strong>${escapeHtml(dash[1].trim())}</strong> – ${escapeHtml(item.slice(dash[0].length))}`.trim();
  }
  const caps = item.match(/^((?:[A-Z0-9&][A-Z0-9'’&.,!-]*\s+){0,7}[A-Z0-9][A-Z0-9'’&.,!-]*)(?=\s|$)/);
  if (caps && caps[1].replace(/[^A-Za-z]/g, '').length >= 6) {
    return `<strong>${escapeHtml(caps[1])}</strong>${escapeHtml(item.slice(caps[1].length))}`;
  }
  return escapeHtml(item);
}

// Descriptions written in the admin rich-text editor arrive as HTML and are
// already laid out; only the imported plain text needs rebuilding.
const formatDescription = (text: string) => {
  if (/<\w+[^>]*>/.test(text)) return unglue(text);
  const items = descriptionItems(text);
  if (!items.length) return '';
  // Concatenation, not a nested template literal. A backtick template inside
  // another template's interpolation makes Astro's frontmatter scanner lose
  // its place, and it then misses the closing --- fence: the whole file
  // compiles as template body and the page 404s with "Icon is not defined".
  const rows = items.map((i) => '<li>' + boldSubject(i) + '</li>').join('');
  return '<ul class="ci-mag-contents">' + rows + '</ul>';
};

const metadata = {
  title: 'Magazines — every issue free to read',
  description:
    'Read every back-issue of Changing Ireland, the national community development magazine, free as PDF downloads.',
};
---

<Layout metadata={metadata}>
  <PageHeader
    title="Magazine Archive"
    subtitle="Just click to read for free. Full archive since 2001 — for all involved in communities as workers, volunteers, activists, students, researchers and policy-makers."
  />

  <section class="px-4 sm:px-6 lg:px-8 py-10 lg:py-14 mx-auto max-w-5xl">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <p class="text-sm text-muted" id="mag-count" aria-live="polite">
        {magazines.length} issue{magazines.length === 1 ? '' : 's'}
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <div>
          <label for="mag-search" class="sr-only">Search issues</label>
          <input
            id="mag-search"
            type="search"
            placeholder="Search issues…"
            class="py-2 px-3.5 w-56 rounded-xl border border-gray-300 bg-white text-sm text-default placeholder:text-gray-500 focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none"
          />
        </div>
        <div class="flex items-center gap-2">
          <label for="mag-sort" class="text-sm font-semibold text-default">Sort by</label>
          <select
            id="mag-sort"
            class="py-2 px-3 rounded-xl border border-gray-300 bg-white text-sm text-default focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none"
          >
            <option value="newest" selected>Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="issue-desc">Issue number (high–low)</option>
            <option value="issue-asc">Issue number (low–high)</option>
          </select>
        </div>
      </div>
    </div>

    {
      magazines.length === 0 ? (
        <p class="text-muted text-lg">The magazine archive is being loaded — check back shortly.</p>
      ) : (
        <ul id="mag-list" class="space-y-8 list-none m-0 p-0">
          {magazines.map((m) => (
            <li
              class="rounded-xl border border-gray-200 bg-white shadow-sm p-5 sm:p-6"
              data-issue={m.issue}
              data-date={m.published_date || '0000'}
              data-search={`${m.title} ${m.description}`.toLowerCase()}
            >
              <div class="grid gap-6 sm:grid-cols-[14rem_minmax(0,1fr)]">
                <a
                  href={`/files/${m.pdf_key}`}
                  tabindex="-1"
                  aria-hidden="true"
                  class="block w-56 max-w-full mx-auto sm:mx-0"
                >
                  {/* Plain <img>, deliberately: covers stream from R2 through
                      /files/ at request time, so Astro Assets can't optimise
                      them. The PDF link below carries the accessible name. */}
                  {m.cover_key ? (
                    <img
                      src={`/files/${m.cover_key}`}
                      alt=""
                      width="320"
                      height="453"
                      loading="lazy"
                      decoding="async"
                      class="w-full rounded-md shadow border border-gray-200 aspect-[320/453] object-cover"
                    />
                  ) : (
                    <span class="block w-full rounded-md bg-primary/10 aspect-[320/453]" aria-hidden="true" />
                  )}
                </a>
                <div>
                  <h2 class="font-heading font-extrabold text-xl md:text-2xl leading-tight mb-1">
                    <a href={`/files/${m.pdf_key}`} class="hover:text-primary transition-colors">
                      {seasonOf(m.title)} (PDF)
                    </a>
                  </h2>
                  {subtitleOf(m.title) && <p class="font-semibold text-default mb-2">{subtitleOf(m.title)}</p>}
                  {/* A div, not a p: rich-text descriptions are made of <p>
                      blocks, which a browser would break out of a parent <p>. */}
                  {m.description && (
                    <div
                      class="text-sm text-muted leading-relaxed break-words [&_strong]:text-default [&_strong]:font-bold [&_ul]:list-none [&_ul]:m-0 [&_ul]:p-0 [&_li]:mb-1 [&_li]:last:mb-0"
                      set:html={formatDescription(m.description)}
                    />
                  )}
                  <a
                    href={`/files/${m.pdf_key}`}
                    class="inline-flex items-center gap-1.5 mt-4 rounded-sm bg-accent px-4 py-2 text-sm font-bold uppercase tracking-wide text-black hover:brightness-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-black"
                  >
                    <Icon name="tabler:file-type-pdf" class="w-4 h-4" aria-hidden="true" />
                    Read for free
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <p id="mag-empty" class="hidden text-muted text-lg py-8">No issues match your search.</p>
  </section>

  <script>
    // Client-side search + sort over the server-rendered list.
    const input = document.getElementById('mag-search') as HTMLInputElement | null;
    const sort = document.getElementById('mag-sort') as HTMLSelectElement | null;
    const list = document.getElementById('mag-list');
    const empty = document.getElementById('mag-empty');
    const count = document.getElementById('mag-count');

    if (input && sort && list && empty && count) {
      const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));

      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const li of items) {
          const show = !q || (li.dataset.search ?? '').includes(q);
          li.classList.toggle('hidden', !show);
          if (show) visible++;
        }
        empty.classList.toggle('hidden', visible > 0);
        count.textContent = `${visible} issue${visible === 1 ? '' : 's'}${q ? ` matching “${input.value.trim()}”` : ''}`;

        const key = sort.value;
        const sorted = [...items].sort((a, b) => {
          const ia = Number(a.dataset.issue);
          const ib = Number(b.dataset.issue);
          const da = a.dataset.date ?? '';
          const db2 = b.dataset.date ?? '';
          switch (key) {
            case 'oldest':
              return da === db2 ? ia - ib : da.localeCompare(db2);
            case 'issue-asc':
              return ia - ib;
            case 'issue-desc':
              return ib - ia;
            default:
              return da === db2 ? ib - ia : db2.localeCompare(da);
          }
        });
        sorted.forEach((li) => list.appendChild(li));
      };

      input.addEventListener('input', apply);
      sort.addEventListener('change', apply);
    }
  </script>
</Layout>
