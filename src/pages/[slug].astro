---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import CiSinglePost from '~/components/blog/CiSinglePost.astro';
import Grid from '~/components/blog/Grid.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { blogPostRobots } from '~/utils/blog';
import { getDb } from '~/lib/auth';
import NewsArticleSchema from '~/components/schema/NewsArticleSchema.astro';
import Lightbox from '~/components/common/Lightbox.astro';
import {
  getPostBySlug,
  getRelatedPosts,
  getPublishedPosts,
  isLive,
  metaDescription,
  parseTaxonomies,
  type PostRow,
} from '~/lib/posts';
import { rowToPost } from '~/lib/post-adapter';
import { renderWpBody } from '~/lib/wp-page-render';
import type { MetaData } from '~/types';
import type { Post } from '~/types';

// Posts render on demand from D1 so /admin publishing is live immediately.
// Slugs are root-level, exactly as they were on the WordPress site, so no
// post URL changed in the rebuild. The ported WordPress pages (volunteering,
// advertise, …) share this URL space and are checked when no post matches.
// about-us has its own bespoke page (src/pages/about-us.astro).
const slug = (Astro.params.slug ?? '').toString();
const db = await getDb();
if (!db || !slug) return new Response(null, { status: 404 });

interface WpPage {
  slug: string;
  title: string;
  description: string;
  sections?: { id: string; title: string }[];
  html: string;
}
const wpPages = Object.fromEntries(
  Object.values(import.meta.glob<{ default: WpPage }>('../data/wp-pages/*.json', { eager: true })).map((m) => [
    m.default.slug,
    m.default,
  ])
);

const row = await getPostBySlug(db, slug);
const isPost = !!row && isLive(row);
// Drafts and not-yet-due scheduled posts stay invisible; an unknown slug
// falls through to the WP pages, then 404.
const wpPage: WpPage | undefined = isPost ? undefined : wpPages[slug.toLowerCase()];
if (!isPost && !wpPage) return new Response(null, { status: 404 });

// The WP exports open with `<div>EYEBROW</div>` and usually a lede paragraph
// before the first section heading. Promote those into the PageHeader
// (tagline + subtitle), matching the bespoke about-us page's design.
const decodeEntities = (s: string) =>
  s
    .replace(/&#8211;/g, '–')
    .replace(/&#8212;/g, '—')
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&#8230;/g, '…')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .trim();

function splitWpHeader(html: string): { tagline?: string; subtitle?: string; body: string } {
  let rest = html;
  let tagline: string | undefined;
  let subtitle: string | undefined;
  const eat = (re: RegExp) => {
    const m = rest.match(re);
    if (m) rest = rest.slice(m[0].length);
    return m;
  };
  eat(/^\s*<div><\/div>\s*/);
  const t = eat(/^\s*<div>([^<]{2,120})<\/div>\s*/);
  if (t) tagline = decodeEntities(t[1]);
  eat(/^\s*<div><\/div>\s*/);
  const s = eat(/^\s*<div>(?:<p>)?([^<]{20,400}?)(?:<\/p>)?<\/div>\s*/);
  if (s) subtitle = s[1].trim();
  return { tagline, subtitle, body: rest };
}

const normalizeTitle = (s: string) =>
  decodeEntities(s)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');

let wpHeader: ReturnType<typeof splitWpHeader> | undefined;
let wpSections = wpPage?.sections ?? [];
if (wpPage) {
  wpHeader = splitWpHeader(wpPage.html);
  // A leading section heading that just repeats the page title (e.g. the
  // "What's On" h2 on /whats-on) would sit right under the identical H1 —
  // drop it and its sidebar entry.
  const dup = wpHeader.body.match(/^\s*<div><h2 id="([^"]+)">(?:<strong>)?([^<]+)(?:<\/strong>)?\s*<\/h2><\/div>\s*/);
  if (dup && normalizeTitle(dup[2]) === normalizeTitle(wpPage.title)) {
    wpHeader.body = wpHeader.body.slice(dup[0].length);
    wpSections = wpSections.filter((sec) => sec.id !== dup[1]);
    // Some pages (whats-on) put the lede after that duplicate heading.
    if (!wpHeader.subtitle) {
      const lede = wpHeader.body.match(/^\s*<div>(?:<p>)?([^<]{20,400}?)(?:<\/p>)?<\/div>\s*/);
      if (lede) {
        wpHeader.subtitle = lede[1].trim();
        wpHeader.body = wpHeader.body.slice(lede[0].length);
      }
    }
  }
  // WP's "Back to top" list blocks point at anchors that no longer exist
  // (section ids were re-slugged on export). The sticky sidebar covers the
  // same need, so drop them rather than restyle dead links.
  wpHeader.body = wpHeader.body.replace(
    /<div><ul>\s*<li>\s*<a href="#[^"]*">\s*Back to top\s*<\/a>\s*<\/li>\s*<\/ul><\/div>/g,
    ''
  );
}

let url = '';
let sidebarRelated: { slug: string; title: string; category?: { slug: string; title: string } }[] = [];
let latest: Post[] = [];
let metadata: MetaData;
// Props for the NewsArticle/BreadcrumbList markup, built alongside the page
// metadata so the two can't drift apart.
let articleSchema: {
  headline: string;
  description: string;
  url: string;
  image?: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  category?: { slug: string; title: string };
} | null = null;

if (isPost) {
  const post = rowToPost(row as PostRow);
  url = String(getCanonical(getPermalink(post.permalink, 'post')));
  // Sidebar "Read more": same-category posts; bottom band: site-wide latest.
  sidebarRelated = (await getRelatedPosts(db, row as PostRow, 5)).map((r) => ({
    slug: r.slug,
    title: r.title,
    category: parseTaxonomies(r.categories).filter((c) => c.slug !== 'uncategorized')[0],
  }));
  latest = (await getPublishedPosts(db, 5))
    .filter((r) => r.slug !== row!.slug)
    .slice(0, 4)
    .map(rowToPost);
  metadata = {
    title: row!.title,
    // No " — Changing Ireland" suffix on articles. Headlines here run to a
    // median of 58 characters, so the 19-character suffix pushed 723 of 971
    // titles past the ~65 Google will show; dropping it brings 448 of them
    // back inside. Search results still show the site name separately, and on
    // a news site the headline is what earns the click.
    ignoreTitleTemplate: true,
    description: metaDescription(row!.excerpt),
    canonical: url,
    robots: { index: blogPostRobots?.index, follow: blogPostRobots?.follow },
    openGraph: { type: 'article', ...(row!.image_url ? { images: [{ url: row!.image_url }] } : {}) },
  };
  articleSchema = {
    headline: row!.title,
    description: metaDescription(row!.excerpt),
    url,
    // Image URLs in D1 are site-relative (/files/…); schema.org needs absolute.
    image: row!.image_url ? String(getCanonical(row!.image_url)) : undefined,
    author: row!.author || undefined,
    datePublished: row!.published_at ?? row!.created_at,
    dateModified: row!.updated_at,
    category: parseTaxonomies(row!.categories).filter((c) => c.slug !== 'uncategorized')[0],
  };
} else {
  metadata = {
    title: wpPage!.title,
    description: wpPage!.description,
  };
}
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {articleSchema && <NewsArticleSchema {...articleSchema} />}
  </Fragment>
  <Lightbox />
  {
    isPost ? (
      <>
        <CiSinglePost row={row as PostRow} url={url} related={sidebarRelated}>
          <Fragment set:html={row!.content} />
        </CiSinglePost>
        {/* Grey Latest News band above the footer, as on the live template */}
        {latest.length > 0 && (
          <section class="bg-gray-50 border-t border-gray-100">
            <div class="px-4 sm:px-6 lg:px-8 py-10 mx-auto max-w-7xl">
              <h2 class="font-heading font-extrabold text-2xl md:text-3xl mb-6">Latest News</h2>
              <Grid posts={latest} />
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        <PageHeader title={wpPage!.title} tagline={wpHeader!.tagline} subtitle={wpHeader!.subtitle} />
        <section class="px-4 sm:px-6 lg:px-8 py-10 lg:py-14 mx-auto max-w-7xl">
          {/* Every ported page uses the same sidebar grid, even with only one
              or two sections — a variable content width read as inconsistent. */}
          <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 lg:items-start">
            {wpSections.length > 0 && (
              <nav aria-label="On this page" class="mb-8 lg:mb-0 lg:sticky lg:top-24">
                <details class="lg:hidden rounded-xl border border-gray-200 bg-gray-50 px-4 py-3" open={false}>
                  <summary class="text-sm font-bold text-heading cursor-pointer">On this page</summary>
                  <ul class="mt-3 space-y-1.5 list-none m-0 p-0">
                    {wpSections.map((s) => (
                      <li>
                        <a href={`#${s.id}`} class="block text-sm text-gray-700 hover:text-primary py-0.5">
                          {s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
                <div class="hidden lg:block">
                  <p class="text-xs font-bold uppercase tracking-wider text-muted mb-3">On this page</p>
                  <ul class="space-y-1 list-none m-0 p-0 border-l-2 border-gray-200">
                    {wpSections.map((s) => (
                      <li>
                        <a
                          href={`#${s.id}`}
                          class="block text-sm text-gray-700 hover:text-primary hover:border-primary border-l-2 border-transparent -ml-0.5 pl-3.5 py-1 leading-snug transition-colors"
                        >
                          {s.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </nav>
            )}
            <div
              class="wp-prose prose max-w-none prose-headings:font-heading prose-headings:text-heading prose-a:text-primary prose-img:rounded-xl
                prose-h2:font-extrabold prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:scroll-mt-24
                prose-h3:font-extrabold prose-h3:text-xl
                prose-h4:text-xs prose-h4:font-bold prose-h4:uppercase prose-h4:tracking-wider prose-h4:text-primary prose-h4:mb-1
                marker:text-primary
                [&_iframe]:w-full [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:rounded-md"
            >
              <Fragment set:html={renderWpBody(wpHeader!.body)} />
            </div>
          </div>
        </section>
      </>
    )
  }
</Layout>

{
  /* The about-us "heading + hairline rule" section style, applied to the WP
    exports' h2s. The headings come from set:html, so Astro's scoped styles
    can't reach them; a flex ::after also can't be expressed with prose-h2:*
    utilities. Hence a global rule keyed off the .wp-prose wrapper. */
}
<style is:global>
  .wp-prose h2 {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .wp-prose h2::after {
    content: '';
    height: 1px;
    flex: 1 1 0;
    min-width: 3rem;
    background: rgb(209 213 219);
  }
  /* Tame tall logo/portrait images from the WP exports; wide banners are
     unaffected. width:auto keeps the aspect ratio when the cap kicks in. */
  .wp-prose img {
    max-height: 22rem;
    width: auto;
    max-width: 100%;
  }
  /* Stat tiles rebuilt from the WP exports' number + label pairs. Equal
     columns so a row of four fills the line instead of wrapping 3 + 1. */
  .wp-prose .ci-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10.5rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 1.25em 0;
  }
  .wp-prose .ci-stat {
    display: flex;
    flex-direction: column;
    background: rgb(249 250 251);
    border: 1px solid rgb(229 231 235);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
  }
  .wp-prose .ci-stat-number {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 1.875rem;
    line-height: 1.2;
    color: var(--aw-color-text-heading);
  }
  .wp-prose .ci-stat-label {
    font-size: 0.875rem;
    color: var(--aw-color-text-muted);
    margin-top: 0.25rem;
    max-width: 14rem;
  }
  /* Card grids built from a section's h3 entries, matching about-us. */
  .wp-prose .ci-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: 1.25rem;
    margin: 1.5em 0 2.5em;
  }
  .wp-prose .ci-card {
    background: #fff;
    border: 1px solid rgb(229 231 235);
    border-radius: 1rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    padding: 1.5rem;
    margin: 0;
  }
  .wp-prose .ci-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }
  .wp-prose .ci-card p,
  .wp-prose .ci-card ul,
  .wp-prose .ci-card ol {
    font-size: 1rem;
    margin: 0.5rem 0;
  }
  .wp-prose .ci-card > :last-child {
    margin-bottom: 0;
  }
  /* Images left in a card flow keep their old restrained size. */
  .wp-prose .ci-card img {
    max-height: 9rem;
    width: auto;
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 0.25rem 0 0.5rem;
  }

  /* Card header image. Declared AFTER the rule above: both are (0,2,1) so
     source order decides, and an earlier position let `width: auto` there win
     and leave headers at their natural width.

     The card's padding is cancelled with negative margins so the photo runs to
     the edges. A fixed height with object-fit: cover is what makes a grid read
     as one set — heights match, and nothing is stretched to get there. */
  .wp-prose .ci-card {
    overflow: hidden;
  }
  .wp-prose .ci-card-media {
    margin: -1.5rem -1.5rem 1.25rem;
    /* A tint behind the letterboxing makes the bands read as a deliberate
       frame rather than a gap, and gives logos on white a soft edge. */
    background: rgb(249 250 251);
    border-bottom: 1px solid rgb(243 244 246);
    padding: 0.75rem;
  }
  .wp-prose .ci-card-media a,
  .wp-prose .ci-card-media img {
    display: block;
  }
  .wp-prose .ci-card-media img {
    width: 100%;
    height: 12.5rem;
    max-width: none;
    max-height: none;
    /* `contain`, not `cover`. Cropping to fill gives a tidier grid, and that
       is what this was until the content was looked at properly: these cards
       carry logos, posters and group photographs, and none of those survive a
       crop. Safe Ireland's logo lost its second half, Activelink's read
       "tivel", and the group shots lost every head. Whitespace around an
       image is a cosmetic cost; a cut-off logo is a broken one. */
    object-fit: contain;
    object-position: center;
    border-radius: 0;
    margin: 0;
  }
  /* The old "odd trailing card" special case lived here: it spanned the last
     card across an otherwise half-empty two-column row and laid it out
     image-beside-text. Cards stack one per row now, so there is no empty half
     to fill — and the selector was still firing, handing five image-free
     entries a 392px text column inside a 1008px row. */

  .wp-prose .ci-card-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--aw-color-primary);
    margin: 0 0 0.25rem;
  }
  /* h4-led entry cards (awards, funds): the lead heading (an h3 for correct
     heading order) is styled as the small eyebrow, like the generic h4s. */
  .wp-prose .ci-card h4 {
    margin: 0 0 0.25rem;
  }
  .wp-prose h3.ci-lead {
    margin: 1.5em 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--aw-color-primary);
  }
  .wp-prose .ci-card h3.ci-lead {
    margin: 0 0 0.25rem;
  }
  .wp-prose .ci-card-meta {
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--aw-color-text-muted);
    margin: 0 0 0.5rem;
  }
  .wp-prose .ci-group-label {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--aw-color-text-heading);
    margin: 2.25rem 0 0.25rem;
  }

  /* ── Standalone page restyle ──────────────────────────────────────────
     Two different things share this wrapper and want different widths.
     Running text wants a readable measure — much past 75 characters and the
     eye loses the line. Card grids want the whole column: at max-w-4xl the
     page left 328px of empty space at the right on a 1728px screen while
     squeezing cards into two columns.

     So the wrapper is unconstrained, and the measure is put back on the text
     elements only. */
  .wp-prose > p,
  .wp-prose > ul,
  .wp-prose > ol,
  .wp-prose > blockquote,
  .wp-prose > .ci-group-label,
  .wp-prose .ci-split {
    max-width: 56rem;
  }

  /* One card per row, stacked. */
  .wp-prose .ci-cards {
    grid-template-columns: 1fr;
  }
  /* Stacked means every card is full width, so each one gets the image-beside-
     text treatment that the odd trailing card already had — a header image
     across 1216px would be a letterbox, and text run to that width is well
     past a comfortable line. */
  @media (min-width: 768px) {
    .wp-prose .ci-card:has(.ci-card-media) {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 1.75rem;
      align-items: center;
    }
    .wp-prose .ci-card:has(.ci-card-media) .ci-card-media {
      margin: -1.5rem 0 -1.5rem -1.5rem;
      border-bottom: 0;
      border-right: 1px solid rgb(243 244 246);
      height: 100%;
      display: grid;
      place-items: center;
    }
    .wp-prose .ci-card:has(.ci-card-media) .ci-card-media img {
      width: 100%;
      height: 15rem;
      max-width: none;
      max-height: none;
      object-fit: contain;
    }
    /* Without an image there is no second column to bound the text, so hold it
       to a readable measure rather than letting it run the full width. */
    .wp-prose .ci-card:not(:has(.ci-card-media)) .ci-card-body > * {
      max-width: 60rem;
    }
  }

  /* Cards are equal height in a row whether or not they carry an image, so
     their innards have to stretch rather than sit at the top of a tall box:
     that is what left "Your local library" with a block of dead space under
     its one line of text. */
  .wp-prose .ci-card {
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .wp-prose .ci-card:hover {
    border-color: rgb(209 213 219);
    box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.12);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .wp-prose .ci-card {
      transition: none;
    }
    .wp-prose .ci-card:hover {
      transform: none;
    }
  }
  .wp-prose .ci-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  /* Pin the closing line to the bottom, so a row of cards has its actions on
     one line instead of wherever each card's text happened to stop — but only
     when that line is the link out. A card whose last element is its body text
     (e.g. "Your local library", one sentence and no link) would otherwise have
     the text itself shoved to the foot of the box, under a gap. */
  .wp-prose .ci-card-body > p:last-child:has(> a:only-child) {
    margin-top: auto;
    margin-bottom: 0;
  }
  .wp-prose .ci-card-body > p:last-child:not(:has(> a:only-child)) {
    margin-bottom: 0;
  }
  /* A card whose last line is just a link is a call to action; make it read
     like one rather than like body copy that happens to be underlined. */
  .wp-prose .ci-card-body > p:last-child > a:only-child {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-decoration: none;
    padding-top: 0.75rem;
  }
  .wp-prose .ci-card-body > p:last-child > a:only-child::after {
    content: '→';
    transition: transform 0.15s ease;
  }
  .wp-prose .ci-card:hover .ci-card-body > p:last-child > a:only-child::after {
    transform: translateX(2px);
  }
  .wp-prose .ci-card-body > p:last-child > a:only-child:hover {
    text-decoration: underline;
  }

  /* ── Entries without an image render as a list, not a card ─────────────
     Researched rather than guessed: GOV.UK's own design-system backlog notes
     that cards are often reached for to paper over a weak hierarchy, and
     their content-heavy browse pages use a bold link with a one-line
     description under a heading — no boxes. /advice-for-groups is exactly
     that shape: 65 entries of title, one sentence and a link. Boxed and
     stacked it ran to nearly 18 screens; as a list it is a fraction of that
     and far quicker to scan.

     Entries that DO carry an image keep the card, because a photograph needs
     a container to sit in. So the treatment follows the content instead of
     being applied uniformly. */
  .wp-prose .ci-card:not(:has(.ci-card-media)) {
    background: none;
    border: 0;
    border-top: 1px solid rgb(229 231 235);
    border-radius: 0;
    box-shadow: none;
    padding: 1.25rem 0;
    margin: 0;
  }
  .wp-prose .ci-card:not(:has(.ci-card-media)):hover {
    background: rgb(249 250 251);
    box-shadow: none;
    transform: none;
    border-color: rgb(229 231 235);
  }
  .wp-prose .ci-cards:has(.ci-card:not(:has(.ci-card-media))) {
    gap: 0;
  }
  .wp-prose .ci-card:not(:has(.ci-card-media)) h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.25rem;
  }
  .wp-prose .ci-card:not(:has(.ci-card-media)) .ci-card-body > p {
    margin: 0.25rem 0;
    color: rgb(75 85 99);
  }
  /* The action link sits inline at the end rather than pinned to a box floor. */
  .wp-prose .ci-card:not(:has(.ci-card-media)) .ci-card-body > p:last-child:has(> a:only-child) {
    margin-top: 0.25rem;
  }
  .wp-prose .ci-card:not(:has(.ci-card-media)) .ci-card-body > p:last-child > a:only-child {
    padding-top: 0;
  }

  /* Standalone photos in the prose flow sit centred rather than hugging the
     left edge of a wide column. */
  .wp-prose > img {
    display: block;
    margin: 1.5rem auto;
  }
  /* Text-left / media-right split for prose sections with images. */
  .wp-prose .ci-split {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin: 1.25em 0 2em;
  }
  @media (min-width: 1024px) {
    .wp-prose .ci-split {
      /* Was 1.25fr/1fr, which left photographs about 390px wide in a 930px
         column and made the pages read as text with thumbnails. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
