---
export const prerender = false;

import Layout from '~/layouts/PageLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import CiSinglePost from '~/components/blog/CiSinglePost.astro';
import Grid from '~/components/blog/Grid.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { blogPostRobots } from '~/utils/blog';
import { getDb } from '~/lib/auth';
import NewsArticleSchema from '~/components/schema/NewsArticleSchema.astro';
import Lightbox from '~/components/common/Lightbox.astro';
import {
  getPostBySlug,
  getRelatedPosts,
  getPublishedPosts,
  isLive,
  metaDescription,
  parseTaxonomies,
  type PostRow,
} from '~/lib/posts';
import { rowToPost } from '~/lib/post-adapter';
import { renderWpBody } from '~/lib/wp-page-render';
import type { MetaData } from '~/types';
import type { Post } from '~/types';

// Posts render on demand from D1 so /admin publishing is live immediately.
// Slugs are root-level, exactly as they were on the WordPress site, so no
// post URL changed in the rebuild. The ported WordPress pages (volunteering,
// advertise, …) share this URL space and are checked when no post matches.
// about-us has its own bespoke page (src/pages/about-us.astro).
const slug = (Astro.params.slug ?? '').toString();
const usesDirectoryLayout = [
  'support-for-individuals',
  'advice-for-groups',
  'volunteering',
  'whats-on',
  'the-community-sector',
  'advertise',
  'studying',
  'community-development',
].includes(slug.toLowerCase());
const db = await getDb();
if (!db || !slug) return new Response(null, { status: 404 });

interface WpPage {
  slug: string;
  title: string;
  description: string;
  sections?: { id: string; title: string }[];
  html: string;
}
const wpPages = Object.fromEntries(
  Object.values(import.meta.glob<{ default: WpPage }>('../data/wp-pages/*.json', { eager: true })).map((m) => [
    m.default.slug,
    m.default,
  ])
);

const row = await getPostBySlug(db, slug);
const isPost = !!row && isLive(row);
// Drafts and not-yet-due scheduled posts stay invisible; an unknown slug
// falls through to the WP pages, then 404.
const wpPage: WpPage | undefined = isPost ? undefined : wpPages[slug.toLowerCase()];
if (!isPost && !wpPage) return new Response(null, { status: 404 });

// The WP exports open with `<div>EYEBROW</div>` and usually a lede paragraph
// before the first section heading. Promote those into the PageHeader
// (tagline + subtitle), matching the bespoke about-us page's design.
const decodeEntities = (s: string) =>
  s
    .replace(/&#8211;/g, '–')
    .replace(/&#8212;/g, '—')
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&#8230;/g, '…')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .trim();

function splitWpHeader(html: string): { tagline?: string; subtitle?: string; body: string } {
  let rest = html;
  let tagline: string | undefined;
  let subtitle: string | undefined;
  const eat = (re: RegExp) => {
    const m = rest.match(re);
    if (m) rest = rest.slice(m[0].length);
    return m;
  };
  eat(/^\s*<div><\/div>\s*/);
  const t = eat(/^\s*<div>([^<]{2,120})<\/div>\s*/);
  if (t) tagline = decodeEntities(t[1]);
  eat(/^\s*<div><\/div>\s*/);
  const s = eat(/^\s*<div>(?:<p>)?([^<]{20,400}?)(?:<\/p>)?<\/div>\s*/);
  if (s) subtitle = s[1].trim();
  return { tagline, subtitle, body: rest };
}

const normalizeTitle = (s: string) =>
  decodeEntities(s)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');

let wpHeader: ReturnType<typeof splitWpHeader> | undefined;
let wpSections = wpPage?.sections ?? [];
if (wpPage) {
  wpHeader = splitWpHeader(wpPage.html);
  // A leading section heading that just repeats the page title (e.g. the
  // "What's On" h2 on /whats-on) would sit right under the identical H1 —
  // drop it and its sidebar entry.
  const dup = wpHeader.body.match(/^\s*<div><h2 id="([^"]+)">(?:<strong>)?([^<]+)(?:<\/strong>)?\s*<\/h2><\/div>\s*/);
  if (dup && normalizeTitle(dup[2]) === normalizeTitle(wpPage.title)) {
    wpHeader.body = wpHeader.body.slice(dup[0].length);
    wpSections = wpSections.filter((sec) => sec.id !== dup[1]);
    // Some pages (whats-on) put the lede after that duplicate heading.
    if (!wpHeader.subtitle) {
      const lede = wpHeader.body.match(/^\s*<div>(?:<p>)?([^<]{20,400}?)(?:<\/p>)?<\/div>\s*/);
      if (lede) {
        wpHeader.subtitle = lede[1].trim();
        wpHeader.body = wpHeader.body.slice(lede[0].length);
      }
    }
  }
  // WP's "Back to top" list blocks point at anchors that no longer exist
  // (section ids were re-slugged on export). The sticky sidebar covers the
  // same need, so drop them rather than restyle dead links.
  wpHeader.body = wpHeader.body.replace(
    /<div><ul>\s*<li>\s*<a href="#[^"]*">\s*Back to top\s*<\/a>\s*<\/li>\s*<\/ul><\/div>/g,
    ''
  );
}

let url = '';
let sidebarRelated: { slug: string; title: string; category?: { slug: string; title: string } }[] = [];
let latest: Post[] = [];
let metadata: MetaData;
// Props for the NewsArticle/BreadcrumbList markup, built alongside the page
// metadata so the two can't drift apart.
let articleSchema: {
  headline: string;
  description: string;
  url: string;
  image?: string;
  author?: string;
  datePublished?: string;
  dateModified?: string;
  category?: { slug: string; title: string };
} | null = null;

if (isPost) {
  const post = rowToPost(row as PostRow);
  url = String(getCanonical(getPermalink(post.permalink, 'post')));
  // Sidebar "Read more": same-category posts; bottom band: site-wide latest.
  sidebarRelated = (await getRelatedPosts(db, row as PostRow, 5)).map((r) => ({
    slug: r.slug,
    title: r.title,
    category: parseTaxonomies(r.categories).filter((c) => c.slug !== 'uncategorized')[0],
  }));
  latest = (await getPublishedPosts(db, 5))
    .filter((r) => r.slug !== row!.slug)
    .slice(0, 4)
    .map(rowToPost);
  metadata = {
    title: row!.title,
    // No " — Changing Ireland" suffix on articles. Headlines here run to a
    // median of 58 characters, so the 19-character suffix pushed 723 of 971
    // titles past the ~65 Google will show; dropping it brings 448 of them
    // back inside. Search results still show the site name separately, and on
    // a news site the headline is what earns the click.
    ignoreTitleTemplate: true,
    description: metaDescription(row!.excerpt),
    canonical: url,
    robots: { index: blogPostRobots?.index, follow: blogPostRobots?.follow },
    openGraph: { type: 'article', ...(row!.image_url ? { images: [{ url: row!.image_url }] } : {}) },
  };
  articleSchema = {
    headline: row!.title,
    description: metaDescription(row!.excerpt),
    url,
    // Image URLs in D1 are site-relative (/files/…); schema.org needs absolute.
    image: row!.image_url ? String(getCanonical(row!.image_url)) : undefined,
    author: row!.author || undefined,
    datePublished: row!.published_at ?? row!.created_at,
    dateModified: row!.updated_at,
    category: parseTaxonomies(row!.categories).filter((c) => c.slug !== 'uncategorized')[0],
  };
} else {
  metadata = {
    title: wpPage!.title,
    description: wpPage!.description,
  };
}
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {articleSchema && <NewsArticleSchema {...articleSchema} />}
  </Fragment>
  <Lightbox />
  {
    isPost ? (
      <>
        <CiSinglePost row={row as PostRow} url={url} related={sidebarRelated}>
          <Fragment set:html={row!.content} />
        </CiSinglePost>
        {/* Grey Latest News band above the footer, as on the live template */}
        {latest.length > 0 && (
          <section class="bg-gray-50 border-t border-gray-100">
            <div class="px-4 sm:px-6 lg:px-8 py-10 mx-auto max-w-7xl">
              <h2 class="font-heading font-extrabold text-2xl md:text-3xl mb-6">Latest News</h2>
              <Grid posts={latest} />
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        <PageHeader title={wpPage!.title} tagline={wpHeader!.tagline} subtitle={wpHeader!.subtitle} />
        <section
          class:list={[
            'px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl',
            usesDirectoryLayout ? 'directory-page py-12 lg:py-20' : 'py-10 lg:py-14',
          ]}
        >
          {/* Every ported page uses the same sidebar grid, even with only one
              or two sections — a variable content width read as inconsistent. */}
          <div
            class:list={[!usesDirectoryLayout && 'lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 lg:items-start']}
          >
            {wpSections.length > 0 && (
              <nav
                aria-label="On this page"
                class:list={[
                  usesDirectoryLayout ? 'directory-index mb-14 lg:mb-20' : 'mb-8 lg:mb-0 lg:sticky lg:top-24',
                ]}
              >
                {usesDirectoryLayout ? (
                  <div
                    id="page-directory"
                    class="scroll-mt-24 rounded-3xl border border-gray-200 bg-gray-50/80 p-6 sm:p-8 lg:p-10"
                  >
                    <div class="max-w-2xl mb-7">
                      <p class="text-xs font-bold uppercase tracking-[0.16em] text-primary mb-2">Page directory</p>
                      <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-heading mb-2">On this page</h2>
                      <p class="text-muted m-0">Jump directly to the section you need.</p>
                    </div>
                    <ol class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 list-none m-0 p-0">
                      {wpSections.map((s) => (
                        <li>
                          <a
                            href={`#${s.id}`}
                            class="group flex h-full items-center gap-4 rounded-2xl border border-gray-200 bg-white p-4 text-heading shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
                          >
                            <span class="font-heading text-sm font-bold leading-snug group-hover:text-primary">
                              {s.title}
                            </span>
                            <span class="ml-auto text-primary" aria-hidden="true">
                              ↓
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                ) : (
                  <>
                    <details class="lg:hidden rounded-xl border border-gray-200 bg-gray-50 px-4 py-3" open={false}>
                      <summary class="text-sm font-bold text-heading cursor-pointer">On this page</summary>
                      <ul class="mt-3 space-y-1.5 list-none m-0 p-0">
                        {wpSections.map((s) => (
                          <li>
                            <a href={`#${s.id}`} class="block text-sm text-gray-700 hover:text-primary py-0.5">
                              {s.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                    <div class="hidden lg:block">
                      <p class="text-xs font-bold uppercase tracking-wider text-muted mb-3">On this page</p>
                      <ul class="space-y-1 list-none m-0 p-0 border-l-2 border-gray-200">
                        {wpSections.map((s) => (
                          <li>
                            <a
                              href={`#${s.id}`}
                              class="block text-sm text-gray-700 hover:text-primary hover:border-primary border-l-2 border-transparent -ml-0.5 pl-3.5 py-1 leading-snug transition-colors"
                            >
                              {s.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                )}
              </nav>
            )}
            <div
              class:list={[
                `wp-prose prose prose-headings:font-heading prose-headings:text-heading prose-a:text-primary prose-img:rounded-xl
                prose-h2:font-extrabold prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:scroll-mt-24
                prose-h3:font-extrabold prose-h3:text-xl
                prose-h4:text-xs prose-h4:font-bold prose-h4:uppercase prose-h4:tracking-wider prose-h4:text-primary prose-h4:mb-1
                marker:text-primary
                [&_iframe]:w-full [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:rounded-md`,
                usesDirectoryLayout ? 'directory-prose max-w-none' : 'max-w-4xl',
              ]}
            >
              <Fragment set:html={renderWpBody(wpHeader!.body, { wrapSections: usesDirectoryLayout })} />
            </div>
          </div>
        </section>
      </>
    )
  }
</Layout>

{
  /* The about-us "heading + hairline rule" section style, applied to the WP
    exports' h2s. The headings come from set:html, so Astro's scoped styles
    can't reach them; a flex ::after also can't be expressed with prose-h2:*
    utilities. Hence a global rule keyed off the .wp-prose wrapper. */
}
<style is:global>
  .wp-prose.directory-prose .ci-content-section {
    margin: 0 0 4rem;
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid rgb(229 231 235);
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 12px 35px rgb(15 23 42 / 0.055);
  }
  .wp-prose.directory-prose .ci-content-section > h2:first-child {
    margin-top: 0;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgb(229 231 235);
  }
  .wp-prose.directory-prose .ci-content-section > h2:first-child::after {
    display: none;
  }
  .wp-prose.directory-prose .ci-content-section > h2:first-child + * {
    margin-top: 1.75rem;
  }
  .wp-prose.directory-prose .ci-back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.65rem 1rem;
    border: 1px solid rgb(209 213 219);
    border-radius: 9999px;
    background: #fff;
    color: var(--aw-color-text-heading);
    font-family: var(--aw-font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }
  .wp-prose.directory-prose .ci-back-to-top:hover {
    color: var(--aw-color-primary);
    border-color: rgb(132 204 22 / 0.65);
    transform: translateY(-1px);
  }
  .wp-prose.directory-prose .ci-cards {
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .wp-prose.directory-prose .ci-card:not(:has(.ci-card-media)) {
    padding: 1.5rem;
    border: 1px solid rgb(229 231 235);
    border-radius: 1rem;
    background: rgb(249 250 251 / 0.7);
  }
  .wp-prose.directory-prose .ci-card:not(:has(.ci-card-media)):hover {
    border-color: rgb(132 204 22 / 0.55);
    background: #fff;
  }
  .wp-prose.directory-prose .ci-card:has(.ci-card-media) {
    padding: 1.25rem;
    box-shadow: none;
  }
  .wp-prose.directory-prose .ci-card a:not(:has(img)) {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .wp-prose.directory-prose .ci-split {
    gap: clamp(1.75rem, 4vw, 3.5rem);
    margin-bottom: 0;
    align-items: center;
  }
  .wp-prose.directory-prose ul:not(.ci-cards ul) li::marker {
    color: var(--aw-color-primary);
  }
  @media (min-width: 768px) {
    .wp-prose.directory-prose .ci-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wp-prose.directory-prose .ci-card:has(.ci-card-media) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .wp-prose.directory-prose .ci-content-section {
      margin-bottom: 2rem;
      border-radius: 1.25rem;
    }
  }
  .wp-prose h2 {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .wp-prose h2::after {
    content: '';
    height: 1px;
    flex: 1 1 0;
    min-width: 3rem;
    background: rgb(209 213 219);
  }
  /* Tame tall logo/portrait images from the WP exports; wide banners are
     unaffected. width:auto keeps the aspect ratio when the cap kicks in. */
  .wp-prose img {
    max-height: 22rem;
    width: auto;
    max-width: 100%;
  }
  /* Stat tiles rebuilt from the WP exports' number + label pairs. Equal
     columns so a row of four fills the line instead of wrapping 3 + 1. */
  .wp-prose .ci-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10.5rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 1.25em 0;
  }
  .wp-prose .ci-stat {
    display: flex;
    flex-direction: column;
    background: rgb(249 250 251);
    border: 1px solid rgb(229 231 235);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
  }
  .wp-prose .ci-stat-number {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 1.875rem;
    line-height: 1.2;
    color: var(--aw-color-text-heading);
  }
  .wp-prose .ci-stat-label {
    font-size: 0.875rem;
    color: var(--aw-color-text-muted);
    margin-top: 0.25rem;
    max-width: 14rem;
  }
  /* Card grids built from a section's h3 entries. Cards WITH images get a
     bordered card with text/image side-by-side; cards WITHOUT images render
     as simple prose (no card box). */
  .wp-prose .ci-cards {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 1.5em 0 2.5em;
  }

  /* Cards WITH images: bordered card, side-by-side layout with 800x800 image area */
  .wp-prose .ci-card:has(.ci-card-media) {
    background: #fff;
    border: 1px solid rgb(229 231 235);
    border-radius: 1rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    padding: 1.5rem;
    margin: 0;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .wp-prose .ci-card:has(.ci-card-media) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: 2rem;
      align-items: start;
    }
  }
  @media (min-width: 1024px) {
    .wp-prose .ci-card:has(.ci-card-media) {
      grid-template-columns: minmax(0, 1fr) 500px;
    }
  }
  .wp-prose .ci-card:has(.ci-card-media) .ci-card-body {
    order: -1;
  }
  .wp-prose .ci-card:has(.ci-card-media) .ci-card-media {
    background: rgb(249 250 251);
    border-radius: 0.75rem;
    padding: 0.75rem;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    max-width: 500px;
  }
  .wp-prose .ci-card:has(.ci-card-media) .ci-card-media a,
  .wp-prose .ci-card:has(.ci-card-media) .ci-card-media img {
    display: block;
  }
  .wp-prose .ci-card:has(.ci-card-media) .ci-card-media img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 0.5rem;
    margin: 0;
  }

  /* Cards WITHOUT images: simple prose style, no card box */
  .wp-prose .ci-card:not(:has(.ci-card-media)) {
    background: transparent;
    border: none;
    border-top: 1px solid rgb(229 231 235);
    border-radius: 0;
    box-shadow: none;
    padding: 1.5rem 0 0;
    margin: 0;
  }

  /* Common card typography */
  .wp-prose .ci-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .wp-prose .ci-card p,
  .wp-prose .ci-card ul,
  .wp-prose .ci-card ol {
    font-size: 1rem;
    margin: 0.5rem 0;
  }
  .wp-prose .ci-card > :last-child,
  .wp-prose .ci-card .ci-card-body > :last-child {
    margin-bottom: 0;
  }
  /* Images left in a card flow keep their old restrained size. */
  .wp-prose .ci-card img {
    max-height: 9rem;
    width: auto;
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 0.25rem 0 0.5rem;
  }
  .wp-prose .ci-card-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--aw-color-primary);
    margin: 0 0 0.25rem;
  }
  /* h4-led entry cards (awards, funds): the lead heading (an h3 for correct
     heading order) is styled as the small eyebrow, like the generic h4s. */
  .wp-prose .ci-card h4 {
    margin: 0 0 0.25rem;
  }
  .wp-prose h3.ci-lead {
    margin: 1.5em 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--aw-color-primary);
  }
  .wp-prose .ci-card h3.ci-lead {
    margin: 0 0 0.25rem;
  }
  .wp-prose .ci-card-meta {
    font-family: var(--aw-font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--aw-color-text-muted);
    margin: 0 0 0.5rem;
  }
  .wp-prose .ci-group-label {
    font-family: var(--aw-font-heading);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--aw-color-text-heading);
    margin: 2.25rem 0 0.25rem;
  }
  /* Standalone photos in the prose flow sit centred rather than hugging the
     left edge of a wide column. */
  .wp-prose > img {
    display: block;
    margin: 1.5rem auto;
  }
  /* Text-left / media-right split for prose sections with images. */
  .wp-prose .ci-split {
    display: grid;
    gap: 1.5rem;
    align-items: start;
    margin: 1.25em 0 2em;
  }
  @media (min-width: 1024px) {
    .wp-prose .ci-split {
      /* Was 1.25fr/1fr, which left photographs about 390px wide in a 930px
         column and made the pages read as text with thumbnails. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .wp-prose .ci-split-text > :first-child {
    margin-top: 0;
  }
  .wp-prose .ci-split-media {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .wp-prose .ci-split-media img {
    /* Fill the column, but only here: this context has no competing height,
       so width + auto height keeps every image in proportion. The per-image
       max-width from sizeImages() stops small logos being upscaled.

       No max-height. Pairing one with a filled width is what distorts an
       image — the height gets capped while the width stays put. Width alone
       bounds these safely enough. */
    width: 100%;
    height: auto;
    max-width: 100%;
    /* Clears the 22rem cap on `.wp-prose img` above. That rule keeps its
