---
/**
 * Single-post layout cloned from the live changingireland.ie article template:
 * two-column header (category, heavy headline and byline left; captioned
 * featured image right), then a body row with a vertical share rail on the
 * left, the article in the middle, and a "Read more" sidebar on the right.
 */
import { Icon } from 'astro-icon/components';
import { getFormattedDate } from '~/utils/utils';
import { parseTaxonomies, type PostRow } from '~/lib/posts';

export interface Props {
  row: PostRow;
  /** Absolute canonical URL, used by the share links. */
  url: string;
  related: { slug: string; title: string; category?: { slug: string; title: string } }[];
}

const { row, url, related } = Astro.props;

const categories = parseTaxonomies(row.categories).filter((c) => c.slug !== 'uncategorized');
const tags = parseTaxonomies(row.tags);
const date = new Date((row.published_at ?? row.created_at).replace(' ', 'T'));

const enc = encodeURIComponent;
const shares = [
  {
    label: 'Share on Facebook',
    icon: 'tabler:brand-facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  },
  {
    label: 'Share on X',
    icon: 'tabler:brand-x',
    href: `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(row.title)}`,
  },
  {
    label: 'Share on WhatsApp',
    icon: 'tabler:brand-whatsapp',
    href: `https://wa.me/?text=${enc(`${row.title} ${url}`)}`,
  },
  {
    label: 'Share on LinkedIn',
    icon: 'tabler:brand-linkedin',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  },
  { label: 'Share by email', icon: 'tabler:mail', href: `mailto:?subject=${enc(row.title)}&body=${enc(url)}` },
];

const shareClass =
  'inline-flex items-center justify-center w-9 h-9 border border-gray-300 rounded-sm text-gray-700 hover:bg-primary hover:border-primary hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary';
---

<article>
  {/* ── Header: title left, captioned image right ─────────────────────── */}
  <header class="px-4 sm:px-6 lg:px-8 pt-10 pb-6 mx-auto max-w-6xl">
    <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
      <div>
        {
          categories[0] && (
            <a
              href={`/category/${categories[0].slug}`}
              class="inline-block text-[0.8125rem] font-semibold text-primary hover:underline mb-3"
            >
              {categories[0].title}
            </a>
          )
        }
        <h1
          class="font-heading font-extrabold text-3xl md:text-4xl lg:text-[2.6rem] leading-[1.1] tracking-tight text-heading mb-5"
        >
          {row.title}
        </h1>
        <p class="flex flex-wrap items-center gap-x-2 text-sm text-muted">
          <Icon name="tabler:calendar" class="w-4 h-4" aria-hidden="true" />
          <time datetime={date.toISOString()}>{getFormattedDate(date)}</time>
          {
            row.author && (
              <>
                <span aria-hidden="true" class="text-gray-300">
                  |
                </span>
                <span>
                  By <strong class="text-default font-semibold">{row.author}</strong>
                </span>
              </>
            )
          }
        </p>
      </div>
      {
        row.image_url && (
          <figure class="m-0">
            {/* Plain <img>: the file streams from R2/origin at request time.
                The caption below carries the description, so alt stays empty. */}
            <img
              src={row.image_url}
              alt=""
              width="960"
              height="640"
              class="w-full aspect-[3/2] object-cover rounded-sm bg-gray-100"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            {row.image_alt && <figcaption class="mt-2 text-xs italic text-muted">{row.image_alt}</figcaption>}
          </figure>
        )
      }
    </div>
  </header>

  {/* ── Body: share rail | article | read-more sidebar ────────────────── */}
  <div class="px-4 sm:px-6 lg:px-8 pb-12 mx-auto max-w-6xl">
    <div class="grid gap-8 lg:grid-cols-[3rem_minmax(0,1fr)_18rem]">
      <div>
        <nav aria-label="Share this article" class="lg:sticky lg:top-24">
          <p class="text-xs font-bold text-default mb-2">Share</p>
          <ul class="flex lg:flex-col gap-2 list-none m-0 p-0">
            {
              shares.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class={shareClass}>
                    <Icon name={s.icon} class="w-4.5 h-4.5" aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <div>
        {
          row.excerpt && (
            <p class="bg-gray-50 border-l-4 border-accent px-5 py-4 mb-6 text-base leading-relaxed text-default">
              {row.excerpt}
            </p>
          )
        }
        <div
          class="ci-article-body prose max-w-none prose-headings:font-heading prose-headings:font-extrabold prose-headings:text-heading prose-a:text-primary prose-img:rounded-sm prose-figcaption:italic mt-2"
        >
          <slot />
        </div>

        {
          tags.length > 0 && (
            <footer class="mt-10 pt-5 border-t-2 border-gray-900 flex flex-wrap items-center gap-2">
              <span class="text-sm font-bold text-default mr-1">Topics</span>
              {tags.map((t) => (
                <a
                  href={`/tag/${t.slug}`}
                  class="rounded-sm bg-gray-100 hover:bg-gray-200 px-3 py-1 text-sm text-gray-800 transition-colors"
                >
                  {t.title}
                </a>
              ))}
            </footer>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24 self-start">
        <h2 class="font-heading font-extrabold text-xl text-heading pb-2 mb-4 border-b-2 border-gray-900">Read more</h2>
        <ul class="space-y-5 list-none m-0 p-0">
          {
            related.map((r) => (
              <li>
                {r.category && (
                  <a
                    href={`/category/${r.category.slug}`}
                    class="inline-block text-xs font-semibold text-primary hover:underline mb-0.5"
                  >
                    {r.category.title}
                  </a>
                )}
                <a
                  href={`/${r.slug}`}
                  class="block font-heading font-bold text-[0.95rem] leading-snug text-heading hover:text-primary transition-colors"
                >
                  {r.title}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</article>
