---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);
// Alt text carried over from WordPress via the adapter (not in the base Post type).
const imageAlt = (post as Post & { imageAlt?: string }).imageAlt;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

{
  /* Card styled after the live changingireland.ie article cards: image, blue
    category label, heavy black headline, grey excerpt, byline. */
}
<article
  class="mb-6 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  {
    image && (
      <div class="relative mb-4 rounded-sm overflow-hidden bg-gray-100">
        {link ? (
          <a href={link} tabindex="-1" aria-hidden="true">
            <Image
              src={image}
              class="w-full aspect-[16/10] object-cover"
              widths={[320, 480, 720, 960]}
              width={900}
              height={563}
              sizes="(min-width: 1024px) 19rem, (min-width: 768px) 31vw, calc(100vw - 2rem)"
              alt=""
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full aspect-[16/10] object-cover"
            widths={[320, 480, 720, 960]}
            width={900}
            height={563}
            sizes="(min-width: 1024px) 19rem, (min-width: 768px) 31vw, calc(100vw - 2rem)"
            alt={imageAlt ?? ''}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )
  }

  {
    post.category && (
      <a
        href={getPermalink(`/category/${post.category.slug}`)}
        class="inline-block text-[0.8125rem] font-semibold text-primary hover:underline mb-1"
      >
        {post.category.title}
      </a>
    )
  }

  <h2 class="text-xl sm:text-2xl font-extrabold leading-tight mb-2 font-heading text-heading">
    {
      link ? (
        <a class="inline-block hover:text-primary transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h2>

  {post.excerpt && <p class="text-muted text-base leading-relaxed line-clamp-3">{post.excerpt}</p>}

  <p class="mt-2 text-sm text-muted">
    {
      (post as Post & { author?: string }).author && (
        <span class="font-semibold">{(post as Post & { author?: string }).author} · </span>
      )
    }
    <time datetime={String(post.publishDate)}>{getFormattedDate(post.publishDate)}</time>
  </p>
</article>
