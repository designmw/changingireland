---
import { Icon } from 'astro-icon/components';

// The masthead live search: input + accent button, with debounced results
// from /api/search rendered as a combobox. Used twice by Header.astro (the
// desktop masthead and the sub-1440px mobile bar), so every element id is
// suffixed by `uid` and the script enhances each form[data-quick-search].
// Without JavaScript the form submits to /search as a plain GET.
interface Props {
  uid: string;
  class?: string;
  /** Positioning/size classes for the results dropdown. */
  resultsClass?: string;
}
const { uid, class: className = '', resultsClass = 'right-0 w-[28rem] max-w-[80vw]' } = Astro.props;
---

<form
  method="get"
  action="/search"
  role="search"
  aria-label="Site search"
  id={`quick-search-${uid}`}
  data-quick-search
  class:list={['relative', className]}
>
  <label for={`quick-search-input-${uid}`} class="sr-only">Search articles</label>
  {
    /* One visual control: the wrapper carries the border and the focus
      state, so the input's own focus outline stays off. */
  }
  <div
    class="flex items-stretch rounded-lg border-2 border-gray-300 bg-white overflow-hidden transition-colors focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20"
  >
    <input
      id={`quick-search-input-${uid}`}
      name="q"
      type="search"
      placeholder="Search 1,000+ articles…"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls={`quick-search-results-${uid}`}
      aria-autocomplete="list"
      class="min-w-0 flex-1 border-0 bg-transparent text-base text-default placeholder:text-gray-500 px-4 py-2 outline-none focus:outline-none focus-visible:outline-none focus:ring-0"
    />
    <button
      type="submit"
      class="shrink-0 bg-accent px-3.5 text-black hover:brightness-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-black"
    >
      <Icon name="tabler:search" class="w-5 h-5" aria-hidden="true" />
      <span class="sr-only">Search</span>
    </button>
  </div>
  <ul
    id={`quick-search-results-${uid}`}
    role="listbox"
    aria-label="Search suggestions"
    class:list={[
      'hidden absolute top-full z-50 mt-2 max-h-[60vh] overflow-y-auto list-none m-0 p-0 divide-y divide-gray-100 rounded-xl bg-white shadow-2xl ring-1 ring-black/10 text-left',
      resultsClass,
    ]}
  >
  </ul>
  <p id={`quick-search-status-${uid}`} class="sr-only" role="status" aria-live="polite"></p>
</form>

<script>
  // Debounced live results with combobox keyboard support (arrows, Enter,
  // Escape). Enhances every data-quick-search form on the page.
  function enhanceQuickSearch(form: HTMLFormElement) {
    if (form.dataset.enhanced === 'yes') return;
    form.dataset.enhanced = 'yes';

    const input = form.querySelector<HTMLInputElement>('input[type="search"]')!;
    const list = form.querySelector<HTMLUListElement>('ul[role="listbox"]')!;
    const status = form.querySelector<HTMLParagraphElement>('p[role="status"]')!;
    let items: { title: string; url: string; category: string; author: string; date: string; image: string }[] = [];
    let active = -1;
    let timer = 0;
    let controller: AbortController | null = null;

    const closeList = () => {
      list.classList.add('hidden');
      list.textContent = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
    };

    // Highlight without rebuilding the list: recreating the <li>s (and their
    // <img>s) on every hover made all the thumbnails flicker.
    const setActive = (i: number) => {
      active = i;
      Array.from(list.children).forEach((el, j) => {
        el.setAttribute('aria-selected', String(j === active));
        el.classList.toggle('bg-primary/5', j === active);
        el.classList.toggle('hover:bg-gray-50', j !== active);
      });
      if (active >= 0) input.setAttribute('aria-activedescendant', `${list.id}-option-${active}`);
      else input.removeAttribute('aria-activedescendant');
    };

    form.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && !list.classList.contains('hidden')) closeList();
    });
    input.addEventListener('blur', () => setTimeout(closeList, 120));

    const render = () => {
      list.textContent = '';
      if (items.length === 0) {
        closeList();
        return;
      }
      items.forEach((item, i) => {
        const li = document.createElement('li');
        li.id = `${list.id}-option-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === active));
        li.className = 'flex items-center gap-4 px-4 py-3 cursor-pointer hover:bg-gray-50';

        if (item.image) {
          const img = document.createElement('img');
          img.src = item.image;
          img.alt = '';
          img.width = 64;
          img.height = 43;
          img.className = 'w-16 h-11 rounded object-cover bg-gray-100 shrink-0';
          li.appendChild(img);
        } else {
          const ph = document.createElement('span');
          ph.className = 'w-16 h-11 rounded bg-primary/10 shrink-0';
          ph.setAttribute('aria-hidden', 'true');
          li.appendChild(ph);
        }

        const body = document.createElement('span');
        body.className = 'min-w-0';
        if (item.category) {
          const cat = document.createElement('span');
          cat.className = 'block text-xs font-semibold text-primary';
          cat.textContent = item.category;
          body.appendChild(cat);
        }
        const title = document.createElement('span');
        title.className = 'block text-[0.95rem] font-semibold leading-snug text-heading';
        title.textContent = item.title;
        body.appendChild(title);
        if (item.author || item.date) {
          const meta = document.createElement('span');
          meta.className = 'block text-xs text-muted mt-0.5';
          meta.textContent = [item.author, item.date].filter(Boolean).join(' · ');
          body.appendChild(meta);
        }
        li.appendChild(body);

        // mousedown, not click — click fires after the input's blur
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          window.location.href = item.url;
        });
        li.addEventListener('mousemove', () => {
          if (active !== i) setActive(i);
        });
        list.appendChild(li);
      });
      list.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
      setActive(active);
    };

    const search = async () => {
      const q = input.value.trim();
      if (q.length < 2) {
        closeList();
        status.textContent = '';
        return;
      }
      controller?.abort();
      controller = new AbortController();
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`, { signal: controller.signal });
        if (!res.ok) return;
        const json = (await res.json()) as { results: typeof items };
        items = json.results;
        active = -1;
        render();
        status.textContent = `${items.length} suggestion${items.length === 1 ? '' : 's'}`;
      } catch {
        /* aborted or offline */
      }
    };

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(search, 150);
    });

    input.addEventListener('keydown', (e) => {
      if (list.classList.contains('hidden')) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive((active + 1) % items.length);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active <= 0 ? items.length - 1 : active - 1);
      } else if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        window.location.href = items[active].url;
      }
    });
  }

  function initQuickSearch() {
    document.querySelectorAll<HTMLFormElement>('form[data-quick-search]').forEach(enhanceQuickSearch);
  }

  initQuickSearch();
  document.addEventListener('astro:page-load', initQuickSearch);
</script>
