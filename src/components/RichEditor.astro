---
/**
 * Quill 2 rich-text editor for the admin screens. Writes clean HTML into a
 * hidden textarea (named `name`) so the surrounding plain <form method="post">
 * keeps working exactly as before — and without JavaScript the textarea
 * itself is shown as a fallback.
 *
 * Toolbar images upload to R2 through /api/admin/upload and are inserted by
 * URL (never base64). A second toolbar button inserts a picture already on
 * the site through the shared <ImageLibraryDialog /> (render it once on the
 * page; the button hides itself when it's absent). The toolbar sticks to the
 * top of the viewport while the article scrolls, so it's always reachable.
 * An "Edit raw HTML" toggle is there for power users and keeps imported
 * markup untouched unless the visual editor is actually used.
 */
interface Props {
  name: string;
  value: string;
  /** 'full' for articles, 'simple' for short blurbs like magazine contents. */
  variant?: 'full' | 'simple';
  label: string;
  labelSuffix?: string;
  required?: boolean;
  hint?: string;
}
const { name, value, variant = 'full', label, labelSuffix = '', required = false, hint = '' } = Astro.props;
const editorId = `rich-${name}`;
---

<div class="rich-editor" data-rich-editor data-variant={variant} data-editor-id={editorId}>
  <div class="flex items-baseline justify-between gap-3 mb-1.5">
    <label for={editorId} class="block text-sm font-semibold text-default">
      {label}
      {labelSuffix && <span class="font-normal text-muted">{labelSuffix}</span>}
    </label>
    <button
      type="button"
      data-rich-toggle
      class="hidden text-xs font-semibold text-primary hover:underline cursor-pointer"
      aria-pressed="false"
    >
      Edit raw HTML
    </button>
  </div>

  {
    /* Quill mounts here; hidden until initialised so no-JS keeps the textarea.
      Quill turns this div into .ql-container and inserts the toolbar as a
      sibling above it — the box chrome lives in the CSS below. */
  }
  <div data-rich-mount class="hidden bg-white"></div>

  <textarea
    id={editorId}
    name={name}
    rows={variant === 'full' ? 18 : 8}
    required={required}
    class="rich-editor-source py-2.5 px-4 block w-full rounded-xl border border-gray-300 bg-white text-default font-mono text-sm leading-relaxed focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none"
    >{value}</textarea
  >
  {hint && <p class="mt-1.5 text-xs text-muted">{hint}</p>}
</div>

<style is:global>
  /* Anchors the floating image toolbar, which is positioned against this box. */
  .rich-editor {
    position: relative;
  }
  /* Quill chrome, tuned to the admin look: toolbar and writing area read as
     one bordered, rounded box. */
  .rich-editor .ql-toolbar.ql-snow {
    border: 1px solid rgb(209 213 219);
    border-radius: 0.75rem 0.75rem 0 0;
    background: #f9fafb;
    font-family: inherit;
    /* Follows the editor down the page so the buttons stay in reach on a long
       article. Sticky is scoped to .rich-editor, so it lets go once the
       writing area scrolls past. */
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .rich-editor .ql-toolbar.ql-snow.is-stuck {
    border-radius: 0;
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.15);
  }
  /* The library button is ours, not Quill's: give it the same footprint. */
  .rich-editor .ql-toolbar .ql-library svg {
    width: 18px;
    height: 18px;
  }
  .rich-editor .ql-toolbar .ql-library:hover svg,
  .rich-editor .ql-toolbar .ql-library:focus svg {
    color: #06c;
  }
  .rich-editor .ql-container.ql-snow {
    border: 1px solid rgb(209 213 219);
    border-top: 0;
    border-radius: 0 0 0.75rem 0.75rem;
    font-family: inherit;
    font-size: 1rem;
  }
  .rich-editor .ql-editor {
    min-height: 20rem;
    line-height: 1.65;
    color: rgb(33 33 33);
  }
  .rich-editor[data-variant='simple'] .ql-editor {
    min-height: 9rem;
  }
  .rich-editor .ql-editor h2,
  .rich-editor .ql-editor h3 {
    font-family: var(--aw-font-heading, inherit);
    font-weight: 800;
  }
  .rich-editor .ql-editor img {
    max-width: 100%;
    border-radius: 0.375rem;
  }
  .rich-editor .ql-editor a {
    color: rgb(24 99 220);
  }
  .rich-editor.is-raw [data-rich-mount] {
    display: none;
  }

  /* ── Floating toolbar for a clicked image ─────────────────────────────── */
  .rich-editor .ql-editor img.rich-image-selected {
    outline: 3px solid var(--aw-color-primary, #2e7412);
    outline-offset: 2px;
  }
  .rich-image-tools {
    position: absolute;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* Never wider than the editor: on a phone the row wraps instead. */
    max-width: calc(100% - 0.5rem);
    box-sizing: border-box;
    padding: 0.375rem;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    border: 1px solid rgb(229 231 235);
  }
  .rich-image-tools[hidden] {
    display: none;
  }
  .rich-image-tools-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem;
  }
  .rich-image-tools button {
    padding: 0.3rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(33 33 33);
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
  }
  .rich-image-tools button:hover {
    background: rgb(243 244 246);
  }
  .rich-image-tools button[aria-pressed='true'] {
    background: var(--aw-color-primary, #2e7412);
    color: #fff;
  }
  .rich-image-tools button.is-danger {
    color: rgb(185 28 28);
  }
  .rich-image-tools button.is-danger:hover {
    background: rgb(254 242 242);
  }
  .rich-image-tools-sep {
    width: 1px;
    align-self: stretch;
    margin: 0.125rem 0.25rem;
    background: rgb(229 231 235);
  }
  .rich-image-alt {
    display: flex;
    align-items: flex-end;
    gap: 0.375rem;
    padding: 0.25rem 0.25rem 0.375rem;
    border-top: 1px solid rgb(243 244 246);
  }
  .rich-image-alt[hidden] {
    display: none;
  }
  .rich-image-alt label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(107 114 128);
    margin-bottom: 0.25rem;
  }
  .rich-image-alt input {
    width: 18rem;
    max-width: 60vw;
    padding: 0.35rem 0.55rem;
    border: 1px solid rgb(209 213 219);
    border-radius: 0.5rem;
    font-size: 0.8125rem;
  }
  .rich-image-alt input:focus {
    outline: none;
    border-color: var(--aw-color-primary, #2e7412);
    box-shadow: 0 0 0 2px rgb(46 116 18 / 0.2);
  }
</style>

<script>
  import Quill from 'quill';
  import { bindEditorContent } from '~/lib/editor-content';
  import 'quill/dist/quill.snow.css';
  import { toResponsiveWebp } from '~/lib/webp-client';
  import { openImageLibrary, hasImageLibrary, invalidateImageLibrary } from '~/lib/image-library';

  /** Open a file picker and resolve with the chosen image, if any. */
  function pickImage(): Promise<File | null> {
    return new Promise((resolve) => {
      const picker = document.createElement('input');
      picker.type = 'file';
      picker.accept = 'image/png,image/jpeg,image/webp,image/gif';
      picker.addEventListener('change', () => resolve(picker.files?.[0] ?? null));
      // A cancelled picker fires no 'change', so the promise simply never
      // settles — nothing is queued on it, so there's nothing to leak.
      picker.click();
    });
  }

  async function uploadImage(file: File): Promise<string | null> {
    const body = new FormData();
    // Compress client-side and include the real responsive candidates used by
    // article cards. Workers cannot run an image encoder after upload.
    const upload = await toResponsiveWebp(file);
    body.append('image', upload.primary);
    upload.variants.forEach(({ width, file: variant }) => body.append(`image_${width}`, variant));
    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body });
      const json = (await res.json()) as { url?: string; error?: string };
      if (!res.ok || !json.url) {
        alert(json.error ?? 'Upload failed — try a smaller image.');
        return null;
      }
      invalidateImageLibrary(); // so the new file shows in the library next time
      return json.url;
    } catch {
      alert('Upload failed — check your connection and try again.');
      return null;
    }
  }

  function initRichEditors() {
    document.querySelectorAll<HTMLElement>('[data-rich-editor]:not([data-enhanced])').forEach((root) => {
      root.dataset.enhanced = 'yes';
      const mount = root.querySelector<HTMLElement>('[data-rich-mount]')!;
      const source = root.querySelector<HTMLTextAreaElement>('textarea')!;
      const toggle = root.querySelector<HTMLButtonElement>('[data-rich-toggle]')!;
      const variant = root.dataset.variant ?? 'full';

      const toolbar =
        variant === 'full'
          ? [
              [{ header: [2, 3, false] }],
              ['bold', 'italic', 'underline', 'strike'],
              ['link', 'image', 'library', 'blockquote'],
              [{ list: 'ordered' }, { list: 'bullet' }],
              [{ align: [] }],
              ['clean'],
            ]
          : [['bold', 'italic'], ['link'], [{ list: 'bullet' }], ['clean']];

      mount.classList.remove('hidden');
      const quill = new Quill(mount, {
        theme: 'snow',
        placeholder: 'Write here…',
        modules: {
          toolbar: {
            container: toolbar,
            handlers: {
              async image() {
                // Take the caret position before the picker steals focus.
                const range = quill.getSelection(true);
                const file = await pickImage();
                if (!file) return;
                const url = await uploadImage(file);
                if (!url) return;
                insertImageAt(range.index, url);
              },
              async library() {
                const range = quill.getSelection(true);
                const url = await openImageLibrary({ title: 'Insert an image', articleHtml: source.value });
                if (!url) return;
                insertImageAt(range.index, url);
              },
            },
          },
        },
      });

      function insertImageAt(index: number, url: string) {
        quill.insertEmbed(index, 'image', url, 'user');
        quill.setSelection(index + 1);
      }

      // Quill builds an empty <button class="ql-library"> for our custom
      // toolbar entry; give it an icon and a name. The upload button gets a
      // name too so the two are told apart by tooltip and screen reader.
      const toolbarEl = root.querySelector<HTMLElement>('.ql-toolbar');
      const uploadBtn = toolbarEl?.querySelector<HTMLButtonElement>('button.ql-image');
      const libraryBtn = toolbarEl?.querySelector<HTMLButtonElement>('button.ql-library');
      if (uploadBtn) {
        uploadBtn.title = 'Upload a photo';
        uploadBtn.setAttribute('aria-label', 'Upload a photo');
      }
      if (libraryBtn) {
        libraryBtn.title = 'Insert a photo from the image library';
        libraryBtn.setAttribute('aria-label', 'Insert a photo from the image library');
        // tabler:library-photo, drawn inline so it works inside Quill's toolbar.
        libraryBtn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
          '<path d="M4 8h12a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2z" />' +
          '<path d="M6 8v-2a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-2" />' +
          '<path d="M2 18l4.5 -4.5a2.5 2.5 0 0 1 3.5 0l2 2a2.5 2.5 0 0 0 3.5 0l2.5 -2.5" />' +
          '<path d="M13 13m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />' +
          '</svg>';
        if (!hasImageLibrary()) libraryBtn.hidden = true;
      }

      // The site header is itself sticky on admin pages, so the toolbar has
      // to stick just beneath it rather than at the viewport edge. Measure the
      // header (it changes height at the burger breakpoint) and flag the
      // toolbar while it is pinned so the CSS can flatten its top corners.
      if (toolbarEl) {
        const stickyHeader = document.querySelector<HTMLElement>('header[data-aw-sticky-header]');
        const headerBottom = () => {
          if (!stickyHeader) return 0;
          const box = stickyHeader.getBoundingClientRect();
          // Only counts while the header is actually pinned at the top.
          return box.top <= 0 && box.bottom > 0 ? Math.round(box.bottom) : 0;
        };
        let ticking = false;
        const update = () => {
          ticking = false;
          const offset = headerBottom();
          toolbarEl.style.top = `${offset}px`;
          const box = toolbarEl.getBoundingClientRect();
          const stuck = box.top <= offset + 1 && root.getBoundingClientRect().bottom > box.bottom;
          toolbarEl.classList.toggle('is-stuck', stuck);
        };
        const schedule = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();
      }

      // The toolbar dropdowns (heading level, alignment) ship without an
      // accessible name — axe aria-command-name, serious.
      root.querySelectorAll<HTMLElement>('.ql-picker').forEach((p) => {
        const label = p.classList.contains('ql-header')
          ? 'Heading level'
          : p.classList.contains('ql-align')
            ? 'Text alignment'
            : 'Editor option';
        p.querySelector('.ql-picker-label')?.setAttribute('aria-label', label);
      });

      // ── Image tools ─────────────────────────────────────────────────────
      // Clicking an image in the editor opens a small toolbar over it:
      // replace the file, set alt text, align it, or remove it. Quill 2 ships
      // no image UI at all, so without this an image can only be deleted by
      // selecting it and pressing backspace.
      const tools = document.createElement('div');
      tools.className = 'rich-image-tools';
      tools.hidden = true;
      tools.setAttribute('role', 'toolbar');
      tools.setAttribute('aria-label', 'Image options');
      // The id comes off the wrapper's data attribute — this script is bundled
      // separately and can't see the component's frontmatter variables.
      const altId = `${root.dataset.editorId ?? 'rich'}-alt`;
      tools.innerHTML = `
        <div class="rich-image-tools-row">
          <button type="button" data-img-act="replace">Replace</button>
          <button type="button" data-img-act="library">Choose existing</button>
          <button type="button" data-img-act="alt" aria-expanded="false">Alt text</button>
          <span class="rich-image-tools-sep" aria-hidden="true"></span>
          <button type="button" data-img-align="" aria-label="Align left" title="Align left">Left</button>
          <button type="button" data-img-align="center" aria-label="Align centre" title="Align centre">Centre</button>
          <button type="button" data-img-align="right" aria-label="Align right" title="Align right">Right</button>
          <span class="rich-image-tools-sep" aria-hidden="true"></span>
          <button type="button" data-img-act="remove" class="is-danger">Remove</button>
        </div>
        <div class="rich-image-alt" hidden>
          <div>
            <label for="${altId}">Image description (alt text)</label>
            <input id="${altId}" type="text" data-img-alt-input placeholder="What the image shows" />
          </div>
          <button type="button" data-img-act="alt-save">Save</button>
        </div>`;
      if (!hasImageLibrary()) tools.querySelector<HTMLButtonElement>('[data-img-act="library"]')!.hidden = true;
      root.appendChild(tools);

      const altPanel = tools.querySelector<HTMLElement>('.rich-image-alt')!;
      const altInput = tools.querySelector<HTMLInputElement>('[data-img-alt-input]')!;
      const altToggle = tools.querySelector<HTMLButtonElement>('[data-img-act="alt"]')!;

      let selected: HTMLImageElement | null = null;

      /** Position in the document of an image's embed, or -1 if it's gone. */
      const indexOfImage = (img: HTMLImageElement): number => {
        // Quill.find maps a DOM node back to its blot; getIndex gives the
        // blot's position in the document.
        const blot = (Quill as unknown as { find(node: Node): unknown }).find(img);
        if (!blot) return -1;
        return (quill as unknown as { getIndex(b: unknown): number }).getIndex(blot);
      };
      const indexOfSelected = (): number => (selected ? indexOfImage(selected) : -1);

      function hideTools() {
        if (selected) selected.classList.remove('rich-image-selected');
        selected = null;
        tools.hidden = true;
        altPanel.hidden = true;
        altToggle.setAttribute('aria-expanded', 'false');
      }

      function showTools(img: HTMLImageElement) {
        if (selected && selected !== img) selected.classList.remove('rich-image-selected');
        selected = img;
        img.classList.add('rich-image-selected');
        tools.hidden = false;
        altPanel.hidden = true;
        altToggle.setAttribute('aria-expanded', 'false');
        altInput.value = img.getAttribute('alt') ?? '';

        // Reflect the current alignment of the image's line.
        const index = indexOfSelected();
        const align = index >= 0 ? ((quill.getFormat(index, 1) as { align?: string }).align ?? '') : '';
        tools.querySelectorAll<HTMLButtonElement>('[data-img-align]').forEach((b) => {
          b.setAttribute('aria-pressed', String((b.dataset.imgAlign ?? '') === align));
        });

        // Sit just above the image, clamped inside the editor box on both
        // axes so it never runs off the right edge on a narrow screen.
        const imgBox = img.getBoundingClientRect();
        const rootBox = root.getBoundingClientRect();
        const top = imgBox.top - rootBox.top - tools.offsetHeight - 8;
        const maxLeft = Math.max(4, rootBox.width - tools.offsetWidth - 4);
        tools.style.top = `${Math.max(4, top)}px`;
        tools.style.left = `${Math.min(maxLeft, Math.max(4, imgBox.left - rootBox.left))}px`;
      }

      quill.root.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.tagName === 'IMG') showTools(target as HTMLImageElement);
        else hideTools();
      });

      // Any click outside the editor and its toolbar dismisses the tools,
      // except inside the image-library dialog, which the tools opened.
      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (tools.hidden || tools.contains(target) || quill.root.contains(target)) return;
        if (document.querySelector('dialog[data-image-library]')?.contains(target)) return;
        hideTools();
      });
      // Typing or scrolling would leave the toolbar stranded beside the image.
      quill.on('text-change', (_d, _o, source) => {
        if (source === 'user' && selected && !quill.root.contains(selected)) hideTools();
      });
      window.addEventListener('scroll', () => selected && showTools(selected), { passive: true });

      tools.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!button || !selected) return;

        const align = button.dataset.imgAlign;
        if (align !== undefined) {
          const index = indexOfSelected();
          if (index >= 0) {
            // Alignment belongs to the line holding the image.
            quill.formatLine(index, 1, 'align', align || false, 'user');
            showTools(selected);
          }
          return;
        }

        switch (button.dataset.imgAct) {
          case 'replace':
          case 'library': {
            // Hold on to the image: the selection can be cleared while the
            // picker or dialog is open, but the swap must still land on it.
            const img = selected;
            let url: string | null;
            if (button.dataset.imgAct === 'replace') {
              const file = await pickImage();
              if (!file) return;
              url = await uploadImage(file);
            } else {
              url = await openImageLibrary({
                title: 'Replace with an existing image',
                current: img.getAttribute('src') ?? '',
                articleHtml: source.value,
              });
            }
            if (!url) return;
            const index = indexOfImage(img);
            if (index < 0) return;
            const alt = img.getAttribute('alt') ?? '';
            // Swap through the document model, not the DOM, or the delta and
            // the submitted HTML would drift apart.
            quill.deleteText(index, 1, 'user');
            quill.insertEmbed(index, 'image', url, 'user');
            if (alt) quill.formatText(index, 1, 'alt', alt, 'user');
            hideTools();
            break;
          }
          case 'alt': {
            const open = altPanel.hidden;
            altPanel.hidden = !open;
            altToggle.setAttribute('aria-expanded', String(open));
            if (open) altInput.focus();
            break;
          }
          case 'alt-save': {
            const index = indexOfSelected();
            if (index >= 0) {
              const value = altInput.value.trim();
              // Empty alt is meaningful: it marks the image as decorative.
              quill.formatText(index, 1, 'alt', value || '', 'user');
              if (selected) selected.setAttribute('alt', value);
            }
            altPanel.hidden = true;
            altToggle.setAttribute('aria-expanded', 'false');
            break;
          }
          case 'remove': {
            const index = indexOfSelected();
            if (index >= 0) quill.deleteText(index, 1, 'user');
            hideTools();
            break;
          }
        }
      });

      altInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          tools.querySelector<HTMLButtonElement>('[data-img-act="alt-save"]')?.click();
        }
      });

      const contentBinding = bindEditorContent(quill, source);

      // The visible textarea is replaced by Quill; keep it in the form but
      // out of view (except in raw mode).
      source.classList.add('hidden');
      // `required` must not block submission while the textarea is hidden.
      source.removeAttribute('required');
      toggle.classList.remove('hidden');

      let raw = false;
      toggle.addEventListener('click', () => {
        raw = !raw;
        contentBinding.setRaw(raw);
        root.classList.toggle('is-raw', raw);
        toggle.setAttribute('aria-pressed', String(raw));
        toggle.textContent = raw ? 'Back to visual editor' : 'Edit raw HTML';
        if (raw) {
          source.classList.remove('hidden');
          source.focus();
        } else {
          source.classList.add('hidden');
        }
      });
    });
  }

  initRichEditors();
  document.addEventListener('astro:page-load', initRichEditors);
</script>
