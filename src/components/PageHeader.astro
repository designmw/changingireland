---
// Shared inner-page title band. Plain brand tint (no background image) —
// the design pass restyles this to match the live changingireland.ie look.
interface Props {
  title: string;
  tagline?: string;
  subtitle?: string;
}
const { title, tagline, subtitle } = Astro.props;
---

{/* Brand band: deep green drawn from the logo's lime (#81e116) hue, with a
    lime accent edge. White text passes WCAG AA on both gradient stops; the
    lime itself never carries text (white-on-lime fails contrast). */}
<section class="relative bg-gradient-to-br from-secondary to-primary border-b-4 border-accent">
  <div class="relative px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl py-12 md:py-16">
    {tagline && <p class="text-base text-white/80 font-bold tracking-wide uppercase mb-2">{tagline}</p>}
    <h1 class="font-extrabold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter text-white">
      {title}
    </h1>
    {subtitle && <p class="mt-4 text-xl text-white/90 max-w-3xl" set:html={subtitle} />}
  </div>
</section>
