---
/**
 * "Where to find us" map, built from `business.address` so it needs no
 * per-client editing beyond that config.
 *
 * The Google embed URL used here takes a plain address query and needs no API
 * key or billing account.
 *
 * Click-to-load, not lazy-loaded. The frame sits in the footer of every page,
 * so embedding it directly contacted Google — and let Google set cookies — for
 * every visitor on every page, with no consent asked. Under GDPR that is a
 * third-party cookie the visitor never agreed to. Nothing is requested from
 * Google now until the visitor asks for the map, which is the same bargain the
 * click-to-play video embeds on /videos already make.
 */
import { Icon } from 'astro-icon/components';
import { business } from '~/config/business';

export interface Props {
  /** Heading above the map. */
  title?: string;
  /** Map zoom level — 15 shows the surrounding streets. */
  zoom?: number;
  class?: string;
}

const { title = 'Where to find us', zoom = 15, class: className = '' } = Astro.props;

const { street, locality, region, postalCode } = business.address;
// Region is dropped when it just repeats the locality ("Limerick" /
// "Co. Limerick"), which would otherwise confuse the geocoder.
const parts = [street, locality, region?.replace(/^Co\.?\s*/i, '') === locality ? '' : region, postalCode, 'Ireland'];
const address = parts.filter(Boolean).join(', ');
const query = encodeURIComponent(address);

const embedSrc = `https://maps.google.com/maps?q=${query}&z=${zoom}&hl=en&output=embed`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${query}`;
---

<div class={className}>
  <div class="mb-4 font-heading font-semibold dark:text-gray-300">{title}</div>

  <div
    class="ci-map overflow-hidden rounded-lg border border-gray-200 dark:border-slate-700 bg-gray-100 dark:bg-slate-800"
    data-map-embed={embedSrc}
    data-map-title={`Map showing ${business.name} at ${address}`}
  >
    <button
      type="button"
      data-map-load
      class="group flex h-56 w-full flex-col items-center justify-center gap-2 px-4 text-center text-sm text-muted transition hover:bg-gray-200/60 dark:hover:bg-slate-700/60"
    >
      <Icon name="tabler:map-pin" class="h-7 w-7 text-primary" aria-hidden="true" />
      <span class="font-semibold text-default dark:text-gray-200 group-hover:underline">Show map</span>
      <span class="text-xs leading-snug">Loads Google Maps, which may set cookies.</span>
    </button>
  </div>

  {
    /* A real link as well as the frame: it works with the keyboard, gives
      directions on mobile, and stands in if the embed is ever blocked. */
  }
  <a
    href={mapsHref}
    target="_blank"
    rel="noopener"
    class="mt-3 inline-flex items-center gap-2.5 text-sm text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out"
  >
    <Icon name="tabler:map-2" class="w-5 h-5 shrink-0" aria-hidden="true" />
    Get directions
  </a>
</div>

<script>
  // Swap the placeholder for the real embed only when asked. Delegated so it
  // survives view transitions without re-binding.
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('[data-map-load]');
    const box = button?.closest<HTMLElement>('.ci-map');
    if (!button || !box) return;

    const src = box.dataset.mapEmbed;
    if (!src) return;

    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = box.dataset.mapTitle ?? 'Map';
    frame.className = 'block w-full h-56 border-0';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    box.replaceChildren(frame);
  });
</script>
