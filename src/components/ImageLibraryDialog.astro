---
/**
 * Shared image-library dialog for the admin editors. Render it once on a page
 * and drive it from a script with `openImageLibrary()` in
 * src/lib/image-library.ts. It lists the images already in the article first,
 * then every picture on the site (admin uploads and the WordPress archive)
 * newest first, with a filename/year search and paged "Show more".
 */
import { Icon } from 'astro-icon/components';

const inputClass =
  'py-2 px-4 block w-full rounded-xl border border-gray-300 bg-white text-default text-sm focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none';
---

<dialog
  data-image-library
  class="rounded-2xl border border-gray-200 shadow-2xl p-0 w-[56rem] max-w-[calc(100vw-2rem)] max-h-[calc(100vh-2rem)] backdrop:bg-black/40 m-auto"
  aria-labelledby="image-library-title"
>
  <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-gray-200">
    <h2 id="image-library-title" data-image-library-title class="font-heading font-extrabold text-lg text-heading m-0">
      Choose an image
    </h2>
    <button
      type="button"
      data-image-library-close
      aria-label="Close"
      class="inline-flex items-center justify-center w-9 h-9 rounded-full text-muted hover:bg-gray-100 hover:text-default"
    >
      <Icon name="tabler:x" class="h-5 w-5" />
    </button>
  </div>
  <div class="p-5 overflow-y-auto max-h-[calc(100vh-7.5rem)]">
    <section data-image-library-article-section class="hidden mb-6">
      <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">Images in this article</p>
      <ul
        data-image-library-article-grid
        class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2.5 list-none m-0 p-0"
      >
      </ul>
    </section>
    <section>
      <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
        <p class="text-xs font-bold uppercase tracking-wider text-muted m-0">Image library</p>
        <div class="w-full sm:w-72">
          <label for="image-library-search" class="sr-only">Search the image library</label>
          <input
            id="image-library-search"
            data-image-library-search
            type="search"
            placeholder="Search by filename or year…"
            autocomplete="off"
            class={inputClass}
          />
        </div>
      </div>
      <p data-image-library-status class="text-sm text-muted empty:hidden" aria-live="polite">Loading…</p>
      <ul data-image-library-grid class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2.5 list-none m-0 p-0"></ul>
      <div class="mt-4 text-center">
        <button type="button" data-image-library-more class="hidden btn-secondary text-sm py-2 px-4">
          Show more
        </button>
      </div>
    </section>
  </div>
</dialog>
