---
// Modal confirmation for admin delete buttons. Intercepts submits from any
// form[data-confirm] (the attribute carries the item's name) and requires an
// explicit choice in a <dialog> before the delete goes through — a double
// click can no longer fall through, which is how the old two-click arm
// pattern lost magazine issue 92. Native <dialog>, so Escape cancels and
// focus is trapped; no window.confirm(), which would block automation.
---

<dialog
  id="admin-confirm-delete"
  class="rounded-2xl border border-gray-200 shadow-2xl p-0 w-[26rem] max-w-[calc(100vw-2rem)] backdrop:bg-black/40 m-auto"
>
  <form method="dialog" class="p-6">
    <h2 class="font-heading font-extrabold text-lg text-heading mb-2 flex items-center gap-2.5">
      <span
        class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-red-100 text-red-600 shrink-0"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5">
          <path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" />
        </svg>
      </span>
      Delete <span class="sr-only">item</span>
    </h2>
    <p class="text-sm text-default mb-1">
      You are about to permanently delete <strong id="admin-confirm-delete-name" class="break-words"></strong>.
    </p>
    <p class="text-sm text-muted mb-5">This cannot be undone.</p>
    <div class="flex justify-end gap-3">
      <button value="cancel" class="btn-secondary text-sm py-2 px-4" autofocus>Cancel</button>
      <button
        value="confirm"
        class="inline-flex items-center rounded-full bg-red-600 text-white text-sm font-semibold py-2 px-5 hover:bg-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2"
      >
        Yes, delete it
      </button>
    </div>
  </form>
</dialog>

<script>
  function initConfirmDelete() {
    const dialog = document.getElementById('admin-confirm-delete') as HTMLDialogElement | null;
    if (!dialog) return;
    const nameEl = document.getElementById('admin-confirm-delete-name')!;
    let pending: HTMLFormElement | null = null;

    document.querySelectorAll<HTMLFormElement>('form[data-confirm]:not([data-guarded])').forEach((form) => {
      form.dataset.guarded = 'yes';
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        pending = form;
        nameEl.textContent = `“${form.dataset.confirm ?? 'this item'}”`;
        dialog.showModal();
      });
    });

    if (dialog.dataset.enhanced !== 'yes') {
      dialog.dataset.enhanced = 'yes';
      dialog.addEventListener('close', () => {
        // requestSubmit would re-trigger the guard; submit() skips handlers.
        if (dialog.returnValue === 'confirm') pending?.submit();
        pending = null;
      });
    }
  }

  initConfirmDelete();
  document.addEventListener('astro:page-load', initConfirmDelete);
</script>
