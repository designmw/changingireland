---
import { getFormattedDate } from '~/utils/utils';
import { parseTaxonomies, type PostRow } from '~/lib/posts';
import Image from '~/components/common/Image.astro';

interface Props {
  posts: PostRow[];
}

const { posts } = Astro.props;
if (posts.length === 0) return null;

const primaryCategory = (p: PostRow) => parseTaxonomies(p.categories).filter((c) => c.slug !== 'uncategorized')[0];
const dateOf = (p: PostRow) => new Date((p.published_at ?? p.created_at).replace(' ', 'T'));

const lead = posts[0];
const rest = posts.slice(1, 4);
---

<section class="bg-black text-white">
  <div class="px-4 sm:px-6 lg:px-8 py-12 lg:py-16 mx-auto max-w-7xl">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="font-heading font-extrabold text-2xl md:text-3xl whitespace-nowrap">Editor's Picks</h2>
      <span class="h-px flex-1 bg-gray-700" aria-hidden="true"></span>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {/* Lead story - large */}
      <article class="group">
        {
          lead.image_url && (
            <a
              href={`/${lead.slug}`}
              tabindex="-1"
              aria-hidden="true"
              class="block mb-4 rounded-sm overflow-hidden bg-gray-800"
            >
              <Image
                src={lead.image_url}
                alt=""
                widths={[480, 720, 960, 1280]}
                width={720}
                height={450}
                sizes="(min-width: 1024px) 37rem, calc(100vw - 2rem)"
                class="w-full aspect-[16/10] object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
                loading="lazy"
                decoding="async"
              />
            </a>
          )
        }
        {
          primaryCategory(lead) && (
            <a
              href={`/category/${primaryCategory(lead)!.slug}`}
              class="inline-block text-[0.8125rem] font-semibold text-primary hover:underline mb-1"
            >
              {primaryCategory(lead)!.title}
            </a>
          )
        }
        <h3 class="font-heading font-extrabold text-xl md:text-2xl leading-tight mb-2">
          <a href={`/${lead.slug}`} class="hover:text-primary transition-colors">
            {lead.title}
          </a>
        </h3>
        <p class="text-gray-300 text-sm leading-relaxed line-clamp-2 mb-2">{lead.excerpt}</p>
        <p class="text-sm text-gray-400">
          {lead.author && <span class="font-semibold text-gray-300">{lead.author} · </span>}
          <time datetime={dateOf(lead).toISOString()}>{getFormattedDate(dateOf(lead))}</time>
        </p>
      </article>

      {/* Secondary stories - stacked */}
      <div class="flex flex-col gap-6">
        {
          rest.map((p) => (
            <article class="group flex gap-4">
              {p.image_url && (
                <a
                  href={`/${p.slug}`}
                  tabindex="-1"
                  aria-hidden="true"
                  class="shrink-0 w-28 md:w-36 rounded-sm overflow-hidden bg-gray-800"
                >
                  <Image
                    src={p.image_url}
                    alt=""
                    widths={[160, 320, 480]}
                    width={144}
                    height={96}
                    sizes="(min-width: 768px) 9rem, 7rem"
                    class="w-full aspect-[3/2] object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="flex flex-col justify-center min-w-0">
                {primaryCategory(p) && (
                  <a
                    href={`/category/${primaryCategory(p)!.slug}`}
                    class="inline-block text-xs font-semibold text-primary hover:underline mb-1"
                  >
                    {primaryCategory(p)!.title}
                  </a>
                )}
                <h3 class="font-heading font-extrabold text-base leading-snug line-clamp-2">
                  <a href={`/${p.slug}`} class="hover:text-primary transition-colors">
                    {p.title}
                  </a>
                </h3>
                <p class="text-xs text-gray-400 mt-1">
                  <time datetime={dateOf(p).toISOString()}>{getFormattedDate(dateOf(p))}</time>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
